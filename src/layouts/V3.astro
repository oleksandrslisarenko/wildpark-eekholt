---
import '@fontsource/alegreya-sans/400.css';
import '@fontsource/alegreya-sans/400-italic.css';
import '@fontsource/alegreya-sans/500.css';
import '@fontsource/alegreya-sans/700.css';
import '@fontsource/alegreya-sans/800.css';
import '@fontsource/alegreya-sans/300-italic.css';
import '../styles/v3.css';
import LangSwitch from '../components/LangSwitch.astro';
import { contact, nav } from '../data/site';
const { title, description = 'Naturerlebnisstätte Wildpark Eekholt: über 700 heimische Wildtiere auf 67 Hektar zwischen Bad Bramstedt und Bad Segeberg. Ganzjährig geöffnet.', active = '' } = Astro.props;
const base = '/v3';
const link = (h: string | null) => (h ? `${base}/${h}/` : null);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/img/eagle.svg" />
</head>
<body class="v3">
  <a class="skip" href="#main">Zum Inhalt</a>
  <header class="top">
    <a class="brand" href={`${base}/`}><img src="/img/logo.svg" alt="Wildpark Eekholt" width="70" height="74" /><em>NaturErlebnisse</em></a>
    <nav aria-label="Hauptnavigation"><ul>{nav.map((n) => <li>{n.href ? <a href={link(n.href)} aria-current={active === n.href ? 'page' : undefined}>{n.label}</a> : <span class="soon" title="Seite folgt nach Auswahl des Designs">{n.label}</span>}</li>)}</ul></nav>
    <div class="tools">
      <span class="pill" data-live="short">täglich</span>
      <button class="ic" type="button" data-search aria-label="Suche öffnen"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
      <LangSwitch />
      <button class="ic burger" type="button" aria-expanded="false" aria-controls="drawer" data-burger aria-label="Menü"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
    </div>
  </header>
  <div class="drawer" id="drawer" hidden>
    <ul>{nav.map((n, i) => <li style={`--i:${i}`}>{n.href ? <a href={link(n.href)}>{n.label}</a> : <span class="soon">{n.label}</span>}</li>)}</ul>
    <LangSwitch />
  </div>
  <main id="main" data-pagefind-body data-pagefind-filter="variant:v3"><slot /></main>
  <footer class="foot">
    <div class="wrap fgrid">
      <div class="fcard">
        <img src="/img/logo.svg" alt="" width="80" height="84" />
        <p>{contact.street}<br />{contact.zip} {contact.city}<br />T <a href={contact.phoneHref}>{contact.phone}</a><br /><a href={`mailto:${contact.mail}`}>{contact.mail}</a></p>
        <p class="small">Ganzjährig geöffnet</p>
      </div>
      <div><h2>Anfahrt</h2><p>Für das Navi:<br />{contact.navi}</p><p>Kostenlose Parkplätze am Park</p></div>
      <div><h2>Mehr</h2><ul class="flinks"><li><a href={contact.shop}>Onlineshop</a></li><li><a href={contact.facebook}>Facebook</a></li><li><a href="#">Kontakt</a></li><li><a href="#">Barrierefreiheit</a></li><li><a href="#">Inhaltsverzeichnis</a></li></ul></div>
      <form class="nl" data-send="Newsletter-Anmeldung" data-ok="Fast fertig: Bitte klicken Sie noch auf den Bestätigungslink in der E-Mail.">
        <h2>Newsletter</h2>
        <p>Neue Termine und Nachrichten aus dem Park.</p>
        <label class="field"><span>E-Mail-Adresse</span><input type="email" name="email" required autocomplete="email" /></label>
        <label class="check"><input type="checkbox" name="einwilligung" value="ja" required /> <span>Ich möchte den Newsletter erhalten und akzeptiere die <a href="#">Datenschutzerklärung</a>.</span></label>
        <button class="btn ink" type="submit">Anmelden</button>
        <p class="msg" data-msg role="status"></p>
      </form>
    </div>
    <div class="wrap fbot"><span>© 2026 Wildpark Eekholt</span><a href="#">Impressum</a><a href="#">Datenschutz</a><span class="proto">Entwurf 3 von 3 · <a href="/">Alle Entwürfe</a></span></div>
  </footer>
  <dialog class="searchdlg" data-searchdlg>
    <form method="dialog"><label><span class="sr">Suche</span><input type="search" placeholder="Was suchen Sie? Wolf, Kindergeburtstag, Preise …" /></label><button aria-label="Schließen">✕</button></form>
    <ul class="results" data-results></ul>
  </dialog>
  <script>
    import { hydrate } from '../scripts/live';
    import { wireForms } from '../scripts/forms';
    import { wireSearch } from '../scripts/search';
    hydrate(); setInterval(() => hydrate(), 60000);
    wireForms(); wireSearch('v3');
    const b = document.querySelector<HTMLButtonElement>('[data-burger]');
    const dr = document.getElementById('drawer')!;
    b?.addEventListener('click', () => { const o = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!o)); dr.hidden = o; });
  </script>
</body>
</html>
