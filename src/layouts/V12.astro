---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/golos-text';
import '@fontsource/caveat/600.css';
import '../styles/v12.css';
import LangDD from '../components/LangDD.astro';
import SettingsDD from '../components/SettingsDD.astro';
import Loader from '../components/Loader.astro';
import Ext from '../components/Ext.astro';
import Icon from '../components/Icon.astro';
import { contact } from '../data/site';
import { sections } from '../data/nav';
const secMap = new Map(sections.map((x) => [x.id, x]));
const { title, description = 'Naturerlebnisstätte Wildpark Eekholt: über 700 heimische Wildtiere auf 67 Hektar zwischen Bad Bramstedt und Bad Segeberg. Ganzjährig geöffnet.', active = '', variant = 'v12' } = Astro.props;
const protoName = variant === 'v2' ? 'Entwurf 2' : variant === 'v3' ? 'Entwurf 3' : 'Entwurf 1';
const base = '/v12';
const nav = [
  { label: 'Start', href: '' },
  { label: 'Besuch planen', href: 'besuch', sec: 'besuch' },
  { label: 'Unsere Tiere', href: 'tiere', sec: 'tiere' },
  { label: 'Veranstaltungen', href: 'veranstaltungen' },
  { label: 'Wolfsmeile', href: 'wolfsmeile', sec: 'wolfsmeile' },
  { label: 'Vogelpflegestation', href: 'vogelpflegestation', sec: 'vogelpflegestation' },
  { label: 'Bildung', href: 'bildung', sec: 'bildung' },
  { label: 'Unterstützen', href: 'unterstuetzen', sec: 'unterstuetzen' },
  { label: 'Kontakt', href: 'kontakt' },
];
const link = (h: string | null) => (h === null ? null : h.startsWith('#') ? h : h ? `${base}/${h}/` : `/${variant}/`);
---
<!doctype html>
<html lang="de" class="pt-holz">
<head>
  <meta charset="utf-8" />
  <script is:inline>try{var p=localStorage.getItem("wp-pt3");if(p&&["none","topo","holz","ringe"].indexOf(p)>-1){document.documentElement.classList.remove("pt-holz");if(p!=="none")document.documentElement.classList.add("pt-"+p);}}catch(e){}</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/img/eagle.svg" />
</head>
<body class={`v12 ${variant !== 'v12' ? 't-' + variant : ''}`}>
  <Loader />
  <a class="skip" href="#main">Zum Inhalt</a>
  <header class="top">
    <a class="brand" href={`/${variant}/`} aria-label="Wildpark Eekholt Startseite"><img src="/img/logo.svg" alt="Wildpark Eekholt" width="58" height="61" /></a>
    <nav class="mainnav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((n) => (
          <li class:list={[{ hasdd: n.sec && secMap.get(n.sec)!.groups.length }]}>
            <a href={link(n.href)} aria-current={active === n.href ? 'page' : undefined}>{n.label}</a>
            {n.sec && secMap.get(n.sec)!.groups.length > 0 && (
              <div class="dd">
                <div class="dd-in">
                  <div class="dd-intro">
                    <Icon name={secMap.get(n.sec)!.scene} set="h" cls="scene" />
                    <p><b>{n.label}</b>{secMap.get(n.sec)!.teaser}</p>
                    <a class="more" href={link(n.href)}>Zur Übersicht</a>
                  </div>
                  {secMap.get(n.sec)!.groups.map((g) => (
                    <div class="dd-col">
                      <p>{g.label}</p>
                      <ul>{g.items.map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <button class="search" type="button" aria-label="Suche öffnen" data-search><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      <LangDD />
      <SettingsDD hero={variant === 'v12'} />
      <a class="btn plate tix" href={contact.shop} rel="noopener" target="_blank">Tickets kaufen <Ext /></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="drawer" data-burger><span></span><span></span><span class="sr">Menü</span></button>
    </div>
  </header>
  <div class="drawer" id="drawer" hidden>
    <ul>
      {nav.map((n) => <li>{n.sec && secMap.get(n.sec)!.groups.length > 0 ? (
        <details><summary>{n.label}</summary><ul>{secMap.get(n.sec)!.groups.flatMap((g) => g.items).map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul></details>
      ) : <a href={link(n.href)}>{n.label}</a>}</li>)}
    </ul>
    <p class="drawer-status" data-live="status">Ganzjährig geöffnet</p>
    <a class="btn ink" href={contact.shop} rel="noopener" target="_blank">Tickets kaufen <Ext /></a>
  </div>
  <main id="main" data-pagefind-body data-pagefind-filter={`variant:${variant}`}><slot /></main>
  <footer class="foot" id="kontakt">
    <div class="foot-grid">
      <div>
        <img src="/img/logo.svg" alt="" width="96" height="101" />
        <p class="foot-claim">NaturErlebnisse seit über 50 Jahren.</p>
      </div>
      <div>
        <h2>Anschrift</h2>
        <p>{contact.legal}<br />{contact.street}, {contact.zip} {contact.city}</p>
        <p>Für das Navi: {contact.navi}</p>
      </div>
      <div>
        <h2>Kontakt</h2>
        <p><a href={contact.phoneHref}>{contact.phone}</a><br /><a href={`mailto:${contact.mail}`}>{contact.mail}</a><br />Büro {contact.office}</p>
        <p><a href={contact.facebook} rel="noopener" target="_blank">Facebook <Ext /></a><br /><a href={contact.shop} rel="noopener" target="_blank">Onlineshop <Ext /></a></p>
      </div>
      <form class="newsletter" data-send="Newsletter-Anmeldung" data-ok="Fast geschafft: Bitte bestätigen Sie den Link in der E-Mail, die wir Ihnen gleich schicken.">
        <h2>Newsletter</h2>
        <p>Veranstaltungen und Neuigkeiten aus dem Park, etwa einmal im Monat.</p>
        <label class="field"><span>E-Mail-Adresse</span><input type="email" name="email" required autocomplete="email" /></label>
        <label class="check"><input type="checkbox" name="einwilligung" value="ja" required /> <span>Ich möchte den Newsletter erhalten und akzeptiere die <a href="/v12/datenschutz/">Datenschutzerklärung</a>.</span></label>
        <button class="btn plate" type="submit">Anmelden</button>
        <p class="msg" data-msg role="status"></p>
      </form>
    </div>
    <nav class="foot-links" aria-label="Weitere Seiten">
      {['besuch', 'tiere', 'bildung', 'unterstuetzen', 'ueber-uns', 'aktuelles', 'aktive-ecke'].map((id) => { const x = secMap.get(id)!; return (
        <div><h2><a href={x.href}>{x.label}</a></h2><ul>{x.groups.flatMap((g) => g.items).slice(0, 7).map((i) => <li><a href={i.href}>{i.label}</a></li>)}</ul></div>
      ); })}
    </nav>
    <div class="foot-bottom">
      <span>© 2026 Wildpark Eekholt</span>
      <a href="/v12/impressum/">Impressum</a><a href="/v12/datenschutz/">Datenschutz</a><a href="/v12/barrierefreiheit/">Barrierefreiheit</a><a href="/v12/inhaltsverzeichnis/">Inhaltsverzeichnis</a><a href="/v12/gaestebuch/">Gästebuch</a><button type="button" class="linkbtn" data-share>Seite weiterempfehlen</button>
      <span class="credits">Icons: <a href="https://openmoji.org" rel="noopener" target="_blank">OpenMoji</a> (CC BY-SA 4.0), <a href="https://khushmeen.com/icons.html" rel="noopener" target="_blank">Doodle Icons</a> (CC0), <a href="https://github.com/oreo-design/doodle-icons" rel="noopener" target="_blank">Oreo Doodle Icons</a> (MIT), Silhouetten in den Mustern: <a href="https://game-icons.net" rel="noopener" target="_blank">game-icons.net</a> (CC BY 3.0)</span>
      <span class="proto">{protoName} · <a href="/">Alle Entwürfe</a></span>
    </div>
  </footer>
  <dialog class="sharedlg" data-sharedlg>
    <form method="dialog" class="sh-close"><button aria-label="Schließen">✕</button></form>
    <h2>Seite weiterempfehlen</h2>
    <p data-share-title></p>
    <div class="sh-row">
      <a class="btn plate" data-share-mail href="#">Per E-Mail</a>
      <a class="btn ink" data-share-wa href="#" target="_blank" rel="noopener">WhatsApp</a>
      <button class="btn ink" type="button" data-share-copy>Link kopieren</button>
    </div>
    <p class="msg" data-share-msg role="status"></p>
  </dialog>
  <dialog class="searchdlg" data-searchdlg>
    <form method="dialog"><label><span class="sr">Suche</span><input type="search" placeholder="Wonach suchen Sie? Zum Beispiel Wolf, Preise, Grillplatz" /></label><button aria-label="Schließen">✕</button></form>
    <ul class="results" data-results></ul>
  </dialog>
  <script>
    import { hydrate } from '../scripts/live';
    import { wireForms } from '../scripts/forms';
    import { wireSearch } from '../scripts/search';
    hydrate(); setInterval(() => hydrate(), 60000);
    wireForms(); wireSearch('v12');
    const b = document.querySelector<HTMLButtonElement>('[data-burger]');
    const dr = document.getElementById('drawer')!;
    b?.addEventListener('click', () => { const o = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!o)); dr.hidden = o; document.body.classList.toggle('lock', !o); });
    // Sprach-Dropdown
    document.querySelectorAll<HTMLElement>('[data-langdd], [data-setdd]').forEach((dd) => {
      dd.querySelector('.setmenu')?.addEventListener('click', (e) => e.stopPropagation());
      const btn = dd.querySelector('button')!;
      const close = () => { btn.setAttribute('aria-expanded', 'false'); dd.classList.remove('open'); };
      btn.addEventListener('click', (e) => { e.stopPropagation(); const o = btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', String(!o)); dd.classList.toggle('open', !o); });
      document.addEventListener('click', close);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    });
    // Entwurfs-Einstellungen: Hero-Variante + Muster (gespeichert, wirkt auf der Startseite)
    {
      const HV = ['3', '4', '8'], PT = ['none', 'topo', 'holz', 'ringe'];
      const get = (k: string, def: string, ok: string[]) => { try { const v = localStorage.getItem(k); return v && ok.includes(v) ? v : def; } catch { return def; } };
      const qs = new URLSearchParams(location.search);
      let hv = qs.get('hero') && HV.includes(qs.get('hero')!) ? qs.get('hero')! : get('wp-hv3', '4', HV);
      let pt = qs.get('muster') && PT.includes(qs.get('muster')!) ? qs.get('muster')! : get('wp-pt3', 'holz', PT);
      const apply = () => {
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        if (hero) {
          hero.classList.remove(...[...hero.classList].filter((c) => /^hv\d$/.test(c) || c.startsWith('pt-')));
          hero.classList.add('hv' + hv);
          if (pt !== 'none') hero.classList.add('pt-' + pt);
        }
        const html = document.documentElement;
        html.classList.remove(...[...html.classList].filter((c) => c.startsWith('pt-')));
        if (pt !== 'none') html.classList.add('pt-' + pt);
        document.querySelectorAll<HTMLElement>('[data-setdd] [data-hv]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.hv === hv)));
        document.querySelectorAll<HTMLElement>('[data-setdd] [data-pt]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pt === pt)));
      };
      document.querySelectorAll<HTMLElement>('[data-setdd] [data-hv]').forEach((b) => b.addEventListener('click', () => { hv = b.dataset.hv!; try { localStorage.setItem('wp-hv3', hv); } catch {} apply(); }));
      document.querySelectorAll<HTMLElement>('[data-setdd] [data-pt]').forEach((b) => b.addEventListener('click', () => { pt = b.dataset.pt!; try { localStorage.setItem('wp-pt3', pt); } catch {} apply(); }));
      apply();
      let ld = get('wp-ld', '1', ['0', '1', '2', '3', '4', '5']);
      const markLd = () => document.querySelectorAll<HTMLElement>('[data-setdd] [data-ld]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ld === ld)));
      document.querySelectorAll<HTMLElement>('[data-setdd] [data-ld]').forEach((b) => b.addEventListener('click', () => { ld = b.dataset.ld!; try { localStorage.setItem('wp-ld', ld); } catch {} markLd(); (window as any).wpLoader?.(ld); }));
      markLd();
    }
    // Seite weiterempfehlen
    {
      const dlg = document.querySelector<HTMLDialogElement>('[data-sharedlg]')!;
      const ru = document.documentElement.lang === 'ru';
      document.querySelectorAll<HTMLElement>('[data-share]').forEach((b) => b.addEventListener('click', async () => {
        const url = location.href, title = document.title;
        if (navigator.share && matchMedia('(pointer: coarse)').matches) { try { await navigator.share({ title, url }); return; } catch {} }
        dlg.querySelector('[data-share-title]')!.textContent = title;
        const body = (ru ? 'Посмотри: ' : 'Schau mal: ') + title + '\n' + url;
        (dlg.querySelector('[data-share-mail]') as HTMLAnchorElement).href = `mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
        (dlg.querySelector('[data-share-wa]') as HTMLAnchorElement).href = `https://wa.me/?text=${encodeURIComponent(body)}`;
        dlg.querySelector('[data-share-msg]')!.textContent = '';
        dlg.showModal();
      }));
      dlg.querySelector('[data-share-copy]')!.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(location.href); dlg.querySelector('[data-share-msg]')!.textContent = ru ? 'Ссылка скопирована.' : 'Link kopiert.'; } catch {}
      });
    }
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.25 });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    // Blöcke und ihre Elemente erscheinen beim Scrollen nacheinander
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const ITEM = 'h1,h2,h3,h4,p,li,figure,article,table,img,picture,dl,details,form,blockquote,.btn,.card,[data-rv-item]';
      const SKIP = '.hx, .ldr, .ticker, .ph12 .illu, [data-rv-skip], dialog, svg';
      const sections = [...document.querySelectorAll<HTMLElement>('main > section, main > div, main > article, footer.foot > div')].filter((s) => !s.matches(SKIP));
      const rio = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return;
        const s = e.target as HTMLElement; rio.unobserve(s); s.classList.add('rv-in');
        // nach dem Erscheinen die Verzögerung wieder entfernen, damit Hover sofort reagiert
        setTimeout(() => s.querySelectorAll('.rv-i').forEach((el) => el.classList.remove('rv-i')), 1600);
      }), { threshold: 0.08, rootMargin: '0px 0px -8% 0px' });
      sections.forEach((sec) => {
        const items: HTMLElement[] = [];
        const walk = (el: Element, depth: number) => {
          for (const c of el.children) {
            const h = c as HTMLElement;
            if (h.matches(SKIP) || h.closest(SKIP)) continue;
            if (h.matches(ITEM)) { items.push(h); continue; }
            if (depth < 6) walk(h, depth + 1);
          }
        };
        walk(sec, 0);
        if (!items.length) return;
        const r = sec.getBoundingClientRect();
        if (r.top < innerHeight * 0.9 && r.bottom > 0) return; // schon sichtbar: nichts verstecken
        items.slice(0, 40).forEach((el, i) => { el.classList.add('rv-i'); el.style.setProperty('--rd', `${Math.min(i, 12) * 70}ms`); });
        rio.observe(sec);
      });
    }
  </script>
</body>
</html>
