---
import '@fontsource-variable/literata';
import '@fontsource-variable/literata/wght-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/v2.css';
import LangSwitch from '../components/LangSwitch.astro';
import { contact, nav } from '../data/site';
const { title, description = 'Naturerlebnisstätte Wildpark Eekholt: über 700 heimische Wildtiere auf 67 Hektar zwischen Bad Bramstedt und Bad Segeberg. Ganzjährig geöffnet.', active = '' } = Astro.props;
const base = '/v2';
const link = (h: string | null) => (h ? `${base}/${h}/` : null);
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/img/eagle.svg" />
</head>
<body class="v2">
  <a class="skip" href="#main">Zum Inhalt</a>
  <div class="todaybar" aria-live="polite">
    <span data-live="status">Täglich geöffnet</span>
    <span class="sep" aria-hidden="true"></span>
    <span data-live="next">Fütterungen täglich ab 10:30 Uhr</span>
    <a href={contact.phoneHref}>{contact.phone}</a>
  </div>
  <header class="top">
    <a class="brand" href={`${base}/`}><img src="/img/logo.svg" alt="Wildpark Eekholt" width="64" height="68" /><span>Naturerlebnisstätte<br />seit über 50 Jahren</span></a>
    <nav aria-label="Hauptnavigation">
      <ul>{nav.map((n) => <li>{n.href ? <a href={link(n.href)} aria-current={active === n.href ? 'page' : undefined}>{n.label}</a> : <span class="soon" title="Seite folgt nach Auswahl des Designs">{n.label}</span>}</li>)}</ul>
    </nav>
    <div class="tools">
      <button class="iconbtn" type="button" data-search aria-label="Suche öffnen"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
      <LangSwitch />
      <button class="iconbtn menu" type="button" aria-expanded="false" aria-controls="drawer" data-burger>Menü</button>
    </div>
  </header>
  <div class="drawer" id="drawer" hidden>
    <ul>{nav.map((n) => <li>{n.href ? <a href={link(n.href)}>{n.label}</a> : <span class="soon">{n.label}</span>}</li>)}</ul>
    <LangSwitch />
  </div>
  <main id="main" data-pagefind-body data-pagefind-filter="variant:v2"><slot /></main>
  <footer class="foot">
    <div class="wrap fgrid">
      <div class="fbrand"><img src="/img/logo.svg" alt="" width="88" height="93" /><p><em>NaturErlebnisse</em> zwischen Osterau und Segeberger Forst.</p></div>
      <div><h2>Besuch</h2><p>Für das Navi:<br />{contact.navi}</p><p>Post: {contact.street}<br />{contact.zip} {contact.city}</p></div>
      <div><h2>Kontakt</h2><p><a href={contact.phoneHref}>{contact.phone}</a><br /><a href={`mailto:${contact.mail}`}>{contact.mail}</a></p><p>Büro {contact.office}</p></div>
      <form class="nl" data-send="Newsletter-Anmeldung" data-ok="Danke! Bitte bestätigen Sie noch den Link in der E-Mail, die gleich bei Ihnen ankommt.">
        <h2>Monatsbrief</h2>
        <p>Was im Park passiert, einmal im Monat per E-Mail.</p>
        <div class="nlrow"><label><span class="sr">E-Mail</span><input type="email" name="email" placeholder="Ihre E-Mail-Adresse" required autocomplete="email" /></label><button type="submit">Anmelden</button></div>
        <label class="check"><input type="checkbox" name="einwilligung" value="ja" required /> <span>Ich akzeptiere die <a href="#">Datenschutzerklärung</a>.</span></label>
        <p class="msg" data-msg role="status"></p>
      </form>
    </div>
    <div class="wrap fbot"><span>© 2026 Wildpark Eekholt</span><a href="#">Impressum</a><a href="#">Datenschutz</a><a href="#">Barrierefreiheit</a><a href={contact.facebook}>Facebook</a><a href={contact.shop}>Onlineshop</a><span class="proto">Entwurf 2 von 3 · <a href="/">Alle Entwürfe</a></span></div>
  </footer>
  <dialog class="searchdlg" data-searchdlg>
    <form method="dialog"><label><span class="sr">Suche</span><input type="search" placeholder="Suchen: Wolf, Grillplatz, Eulentag …" /></label><button aria-label="Schließen">Schließen</button></form>
    <ul class="results" data-results></ul>
  </dialog>
  <script>
    import { hydrate } from '../scripts/live';
    import { wireForms } from '../scripts/forms';
    import { wireSearch } from '../scripts/search';
    hydrate(); setInterval(() => hydrate(), 60000);
    wireForms(); wireSearch('v2');
    const b = document.querySelector<HTMLButtonElement>('[data-burger]');
    const dr = document.getElementById('drawer')!;
    b?.addEventListener('click', () => { const o = b.getAttribute('aria-expanded') === 'true'; b.setAttribute('aria-expanded', String(!o)); dr.hidden = o; b.textContent = o ? 'Menü' : 'Schließen'; });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.3 });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  </script>
</body>
</html>
