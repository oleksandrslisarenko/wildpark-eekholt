---
// Entwurfs-Einstellungen: Hero-Variante und Hintergrundmuster der Startseite
const heroes = [['3', '1'], ['4', '2'], ['8', '3']];
const pats = [['none', 'Ohne'], ['topo', 'Topo'], ['holz', 'Holz'], ['ringe', 'Ringe']];
---
<div class="langdd setdd" data-setdd>
  <button type="button" aria-haspopup="true" aria-expanded="false" aria-label="Einstellungen" title="Einstellungen"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h4M12 17h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="7" r="2.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="17" r="2.2" fill="none" stroke="currentColor" stroke-width="2"/></svg><span>Einstellungen</span><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
  <div class="setmenu" role="group" aria-label="Einstellungen">
    <p>Hero</p>
    <div class="seg">{heroes.map(([v, l]) => <button type="button" data-hv={v} aria-pressed="false">{l}</button>)}</div>
    <p>Hintergrund</p>
    <div class="seg">{pats.map(([v, l]) => <button type="button" data-pt={v} aria-pressed="false">{l}</button>)}</div>
  </div>
</div>
