---
// Inhalte der alten Seiten als saubere Blöcke
import Icon from './Icon.astro';
type B = any;
const { blocks } = Astro.props as { blocks: B[] };
const kb = (n: number) => (n > 1e6 ? `${(n / 1e6).toFixed(1).replace('.', ',')} MB` : n ? `${Math.max(1, Math.round(n / 1e3))} KB` : '');
const strip = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

// Gruppieren: Logo + Text -> Karte; mehrere Bilder hintereinander -> Galerie
const out: B[] = [];
for (let i = 0; i < blocks.length; i++) {
  const b = blocks[i];
  const small = b.t === 'img' && b.w < 420;
  if (small && b.href && blocks[i + 1]?.t === 'p') {
    const card = { t: 'card', img: b, html: blocks[i + 1].html }; i++;
    if (out.at(-1)?.t === 'cards') out.at(-1).items.push(card); else out.push({ t: 'cards', items: [card] });
    continue;
  }
  if (b.t === 'img') {
    const prev = out.at(-1);
    if (prev?.t === 'img') { out[out.length - 1] = { t: 'gallery', imgs: [prev, b], caps: [] }; continue; }
    if (prev?.t === 'gallery') { prev.imgs.push(b); continue; }
  }
  out.push(b);
}
// kleine Einzelbilder neben den folgenden Absatz stellen
const isSmall = (b: B) => b.t === 'img' && b.w < 520 && !b.href;
---
{out.map((b, i) => {
  if (b.t === 'h') return b.l <= 2 ? <h2 set:html={b.html} /> : <h3 set:html={b.html} />;
  if (b.t === 'p') return <p set:html={b.html} />;
  if (b.t === 'ul') return <ul class="tick">{b.items.map((x: string) => <li set:html={x} />)}</ul>;
  if (b.t === 'ol') return <ol class="num">{b.items.map((x: string) => <li set:html={x} />)}</ol>;
  if (b.t === 'img') return (
    <figure class:list={['fig', { side: isSmall(b) }]}>
      {b.href ? <a href={b.href} target={b.href.startsWith('http') ? '_blank' : undefined} rel="noopener"><img src={b.src} srcset={b.sm !== b.src ? `${b.sm} 640w, ${b.src} 1200w` : undefined} sizes="(max-width: 900px) 100vw, 720px" alt={b.alt} loading="lazy" width={b.w} height={b.h} /></a>
        : <img src={b.src} srcset={b.sm !== b.src ? `${b.sm} 640w, ${b.src} 1200w` : undefined} sizes="(max-width: 900px) 100vw, 720px" alt={b.alt} loading="lazy" width={b.w} height={b.h} />}
    </figure>
  );
  if (b.t === 'gallery') return (
    <div class="gal" style={`--n:${Math.min(b.imgs.length, 4)}`}>
      {b.imgs.map((im: B) => <figure>{im.href ? <a href={im.href} target="_blank" rel="noopener"><img src={im.sm} alt={im.alt} loading="lazy" /></a> : <img src={im.sm} alt={im.alt} loading="lazy" />}</figure>)}
    </div>
  );
  if (b.t === 'cards') return (
    <div class="logos">
      {b.items.map((c: B) => <div class="logo"><a href={c.img.href} target="_blank" rel="noopener" class="lg"><img src={c.img.sm} alt="" loading="lazy" /></a><p set:html={c.html} /></div>)}
    </div>
  );
  if (b.t === 'table') return (
    <div class="tbl"><table>{b.rows.map((r: string[], ri: number) => <tr>{r.map((c) => (ri === 0 && b.rows.length > 2 && r.every((x) => strip(x).length < 40) && r.some((x) => /<strong>/.test(x)) ? <th set:html={c} /> : <td set:html={c} />))}</tr>)}</table></div>
  );
  if (b.t === 'faq') return (
    <div class="faq">
      {b.items.map((q: B, k: number) => (
        <details open={k === 0}>
          <summary><span set:html={q.q} /><i aria-hidden="true"></i></summary>
          <div class="a">{q.a.map((x: B) => x.t === 'p' ? <p set:html={x.html} /> : x.t === 'ul' ? <ul class="tick">{x.items.map((y: string) => <li set:html={y} />)}</ul> : x.t === 'img' ? <img src={x.sm} alt="" loading="lazy" /> : null)}</div>
        </details>
      ))}
    </div>
  );
  if (b.t === 'dl') return (
    <ul class="dls">
      {b.items.map((d: B) => <li><a href={d.href} download><Icon name="pdf" set="h" /><span><b>{d.label}</b><small>{d.href.split('.').pop()!.toUpperCase()}{d.size ? ` · ${kb(d.size)}` : ''}</small></span></a></li>)}
    </ul>
  );
  return null;
})}
