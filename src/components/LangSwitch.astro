---
// DE und RU aktiv, EN/DA vorbereitet. Die russischen Seiten entstehen beim Build unter /ru/… (scripts/translate.mjs).
const { cls = '' } = Astro.props;
const path = Astro.url.pathname;
---
<ul class={`lang ${cls}`} aria-label="Sprache" data-langswitch data-path={path}>
  <li><span aria-current="true" title="Deutsch" lang="de">DE</span></li>
  <li><a href={`/ru${path}`} hreflang="ru" lang="ru" title="Русский">RU</a></li>
  <li><span class="off" aria-disabled="true" title="English – in Vorbereitung">EN</span></li>
  <li><span class="off" aria-disabled="true" title="Dansk – i forberedelse">DA</span></li>
</ul>
