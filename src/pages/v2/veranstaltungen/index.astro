---
import L from '../../../layouts/V2.astro';
import { events } from '../../../data/site';
import { MONTHS_LONG, TODAY, lastDate, cleanTime } from '../../../data/helpers';
const iso = TODAY.toISOString().slice(0, 10);
const C = 210, R1 = 200, R0 = 128;
const pt = (r: number, a: number) => [C + r * Math.sin(a), C - r * Math.cos(a)];
const seg = (i: number) => {
  const a0 = (i / 12) * Math.PI * 2 + 0.012, a1 = ((i + 1) / 12) * Math.PI * 2 - 0.012;
  const [x0, y0] = pt(R1, a0), [x1, y1] = pt(R1, a1), [x2, y2] = pt(R0, a1), [x3, y3] = pt(R0, a0);
  return `M${x0} ${y0} A${R1} ${R1} 0 0 1 ${x1} ${y1} L${x2} ${y2} A${R0} ${R0} 0 0 0 ${x3} ${y3}Z`;
};
const counts = MONTHS_LONG.map((_, i) => events.filter((e) => e.m === i + 1).length);
const dayOfYear = (TODAY.getTime() - new Date(TODAY.getFullYear(), 0, 1).getTime()) / 864e5;
const nowA = (dayOfYear / 365) * Math.PI * 2;
const [nx0, ny0] = pt(R0 - 14, nowA), [nx1, ny1] = pt(R1 + 10, nowA);
const dateText = (d: string) => d.replace(/ und /g, ', ').replace(/Vsl\. /, 'voraussichtl. ');
---
<L title="Veranstaltungen 2026 – Wildpark Eekholt" description="Alle Veranstaltungen im Wildpark Eekholt 2026: Wolfsnächte, Eulentag, Dunkel-Munkel-Nächte, Weihnachtsmarkt. Im Eintritt enthalten." active="veranstaltungen">
  <div class="wrap pagehead">
    <p class="crumbs"><a href="/v2/">Start</a><span>Veranstaltungen</span></p>
    <h1>Das Jahr im Wildpark</h1>
    <p>28 Termine 2026, von der Winterwanderung bis zur Wildweihnacht. Alle Sonderveranstaltungen sind im Eintritt enthalten und auch mit der Jahreskarte nutzbar.</p>
  </div>
  <section class="sec" style="padding-top:40px">
    <div class="wrap yearwrap">
      <div class="ring">
        <svg viewBox="-10 -10 440 440" role="group" aria-label="Monate auswählen">
          {MONTHS_LONG.map((mn, i) => {
            const mid = ((i + 0.5) / 12) * Math.PI * 2;
            const [tx, ty] = pt((R0 + R1) / 2, mid);
            return (
              <g class={`seg ${counts[i] ? 'has' : ''}`} data-m={i + 1} role="button" tabindex="0" aria-pressed="false" aria-label={`${mn}: ${counts[i]} Termine`}>
                <path d={seg(i)} />
                <text x={tx} y={ty - 4} text-anchor="middle">{mn.slice(0, 3)}</text>
                <text x={tx} y={ty + 13} text-anchor="middle" style="font-size:11px;opacity:.7">{counts[i]}</text>
              </g>
            );
          })}
          <circle class="draw" cx={C} cy={C} r={R1 + 6} fill="none" stroke="var(--line)" stroke-width="1" />
          <line class="nowline" x1={nx0} y1={ny0} x2={nx1} y2={ny1} />
          <text class="center" x={C} y={C - 2}>2026</text>
          <text class="center2" x={C} y={C + 22}>heute: 23. November</text>
        </svg>
        <div class="ringbtns"><button type="button" data-m="upcoming" aria-pressed="true">Ab heute</button><button type="button" data-m="all" aria-pressed="false">Ganzes Jahr</button><a class="btn ghost" style="padding:7px 14px;font-size:14px" href="#">Kalender als PDF</a></div>
      </div>
      <ol class="evlist">
        {events.map((e) => {
          const past = (lastDate(e) || '') < iso;
          return (
            <li data-m={e.m} data-past={past ? '1' : '0'} class={past ? 'past' : ''}>
              <div><p class="when">{dateText(e.date)} · {cleanTime(e.time)}</p><h3>{e.title}</h3><p>{e.text}</p></div>
              {e.img ? <img src={e.img} alt="" loading="lazy" /> : <span></span>}
            </li>
          );
        })}
      </ol>
    </div>
  </section>
  <script>
    const segs = [...document.querySelectorAll<SVGGElement>('.seg')];
    const btns = [...document.querySelectorAll<HTMLButtonElement>('.ringbtns button')];
    const items = [...document.querySelectorAll<HTMLElement>('.evlist li')];
    function apply(m: string) {
      segs.forEach((s) => s.setAttribute('aria-pressed', String(s.dataset.m === m)));
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === m)));
      items.forEach((li) => { li.hidden = !(m === 'all' || (m === 'upcoming' ? li.dataset.past === '0' : li.dataset.m === m)); });
    }
    segs.forEach((s) => { s.addEventListener('click', () => apply(s.dataset.m!)); s.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); apply(s.dataset.m!); } }); });
    btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.m!)));
    apply('upcoming');
  </script>
</L>
