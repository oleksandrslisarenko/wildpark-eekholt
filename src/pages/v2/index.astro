---
import L from '../../layouts/V2.astro';
import { img, srcset, highlights, prices, fmt, contact, animalPhotos } from '../../data/site';
import { upcoming, dayLabel, cleanTime, slotsToday, eventPhoto, flightSeason } from '../../data/helpers';
const ev = upcoming(5);
const [first, ...rest] = ev;
const fd = dayLabel(first.next);
const plates = [
  { slug: 'wolf', name: 'Wolf', latin: 'Canis lupus', where: 'Wolfsmeile' },
  { slug: 'otter', name: 'Fischotter', latin: 'Lutra canadensis', where: 'Fütterung 10:30 und 15:00' },
  { slug: 'wildkatze', name: 'Wildkatze', latin: 'Felis silvestris', where: 'Waldgehege' },
  { slug: 'weisses_rotwild', name: 'Weißes Rotwild', latin: 'Cervus elaphus', where: 'Freigehege' },
  { slug: 'storch', name: 'Weißstorch', latin: 'Ciconia ciconia', where: 'Fütterung 14:45' },
  { slug: 'uhu', name: 'Uhu', latin: 'Bubo bubo', where: 'Vogelpflegestation' },
];
---
<L title="Wildpark Eekholt – Naturerlebnisse im Norden Hamburgs">
  <div class="wrap">
    <section class="spread">
      <div>
        <h1>Heimische Wildtiere, <em>ganz aus der Nähe</em></h1>
        <p class="lede">Über 700 Tiere aus 100 Arten auf 67 Hektar Wald, Wiese und Moor an der Osterau. Täglich und das ganze Jahr geöffnet.</p>
        <p><a class="btn solid" href="/v2/besuch/">Preise und Öffnungszeiten</a> &nbsp; <a class="btn ghost" href="/v2/veranstaltungen/">Veranstaltungen</a></p>
        <div class="counts"><span><b>700</b>Tiere</span><span><b>100</b>Arten</span><span><b>67</b>Hektar</span><span><b>50+</b>Jahre</span></div>
      </div>
      <figure>
        <img src={img('waldkauz', 1200)} srcset={srcset('waldkauz')} sizes="(max-width: 860px) 100vw, 50vw" alt="Junger Waldkauz sitzt auf einem Ast" fetchpriority="high" />
        <figcaption><span>Junger Waldkauz, <i>Strix aluco</i></span><span>aus der Vogelpflegestation</span></figcaption>
      </figure>
    </section>
  </div>

  <section class="sec">
    <div class="wrap ruled">
      <div class="side"><h2>Heute</h2><p>{flightSeason() ? 'Fütterungen und Flugvorführungen.' : 'Öffentliche Fütterungen. Flugvorführungen wieder ab 14. März 2027.'} Abweichungen zeigt die Tafel am Eingang.</p></div>
      <div>
        <p class="big-h">Wann es im Park <em>etwas zu sehen</em> gibt</p>
        <ol class="daylog">{slotsToday().map((s) => <li data-slot={s.time} data-kind={s.kind}><time>{s.time}</time><span>{s.what}</span></li>)}</ol>
      </div>
    </div>
  </section>

  <section class="sec leaf">
    <div class="wrap ruled">
      <div class="side"><h2>Termine</h2><p>Alle Sonderveranstaltungen sind im Eintritt enthalten.</p><p><a href="/v2/veranstaltungen/">Ganzes Jahr ansehen</a></p></div>
      <div class="evrow">
        <article>
          <figure><img src={img(eventPhoto[first.title] || 'weihnachtsmarkt', 1200)} alt="" loading="lazy" /></figure>
          <h3>{first.title}</h3>
          <p class="when">{fd.wd} {fd.day}. {fd.monLong}, {cleanTime(first.time)}</p>
          <p>{first.text}</p>
        </article>
        <ul class="elist">
          {rest.map((e) => { const d = dayLabel(e.next); return <li><span class="day">{d.day}<small>{d.mon}, {d.wd}</small></span><div><h4>{e.title}</h4><p>{cleanTime(e.time)}</p></div></li>; })}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap ruled">
      <div class="side"><h2>Tiere</h2><p>33 Arten stellen sich mit Steckbrief vor.</p><p><a href="/v2/tier/">Alle Tiere von A bis Z</a></p></div>
      <div>
        <p class="big-h">Wer hier lebt</p>
        <div class="plates">
          {plates.map((p) => (
            <a href="/v2/tier/">
              <img src={img(animalPhotos[p.slug], 640)} alt={p.name} loading="lazy" />
              <div class="cap"><span><b>{p.name}</b><br /><i>{p.latin}</i></span><span>{p.where}</span></div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec leaf">
    <div class="wrap">
      <div class="theme">
        <figure><img src={img('woelfe', 1200)} alt="Zwei Wölfe im Gehege" loading="lazy" /><figcaption class="cap"><span>Wölfe an der Wolfsmeile</span><span>Fütterung täglich 15:30</span></figcaption></figure>
        <div><p class="note">Wolfsinformationszentrum Schleswig-Holstein</p><h3>Eekholter Wolfsmeile</h3><p>{highlights.wolfsmeile}</p><a class="btn solid" href="#">Zur Wolfsmeile</a></div>
      </div>
      <div class="theme flip">
        <figure><img src={img('uhu-untersuchung', 1200)} alt="Uhu wird untersucht" loading="lazy" /><figcaption class="cap"><span>Uhu bei der Untersuchung</span><span>ehrenamtlich seit fast 50 Jahren</span></figcaption></figure>
        <div><p class="note">Greifvögel, Eulen, Störche, Kraniche</p><h3>Vogelpflegestation</h3><p>{highlights.pflegestation}</p><p class="callout">{highlights.pflegeTel}</p></div>
      </div>
    </div>
  </section>

  <section class="sec dark">
    <div class="wrap ruled">
      <div class="side"><h2>Eintritt</h2><p>Kinder unter 4 Jahren frei. Gruppen ab 20 Personen günstiger.</p></div>
      <div>
        <div class="pricegrid">
          <div><b>{fmt(prices.single[0].price)}</b><span>Erwachsene</span></div>
          <div><b>{fmt(prices.single[1].price)}</b><span>Ermäßigt</span></div>
          <div><b>{fmt(prices.single[2].price)}</b><span>Kinder 4–16</span></div>
          <div><b>{fmt(prices.family.price)}</b><span>Familienkarte</span></div>
        </div>
        <p style="margin-top:32px;max-width:60ch">Jahreskarte 2027: gültig ab 1. Dezember 2026, also 13 Monate zum Preis von 12. Ab 33,50 € für Kinder, 102,50 € für die ganze Familie.</p>
        <a class="btn lime" href="/v2/besuch/">Alle Preise</a> &nbsp; <a class="btn ghost" style="border-color:var(--paper)" href={contact.shop}>Jahreskarte bestellen</a>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap ruled">
      <div class="side"><h2>Anfahrt</h2></div>
      <div class="twocol">
        <div>
          <p class="big-h" style="margin-bottom:16px">Eine knappe Stunde von Hamburg</p>
          <p>Am Nordrand des Segeberger Forstes zwischen Bad Bramstedt und Bad Segeberg. Parken direkt am Park, kostenlos auch für Busse.</p>
          <p class="callout">Fürs Navi: <b>{contact.navi}</b></p>
        </div>
        <figure style="margin:0"><img src="/img/lageplan-640.webp" alt="Lageplan des Wildparks" loading="lazy" style="mix-blend-mode:multiply" /><figcaption class="cap"><span>Lageplan mit Rundwegen</span><span>interaktive Karte folgt</span></figcaption></figure>
      </div>
    </div>
  </section>
</L>
