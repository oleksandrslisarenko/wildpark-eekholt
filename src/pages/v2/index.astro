---
import L from '../../layouts/V12.astro';
import Icon from '../../components/Icon.astro';
import Ext from '../../components/Ext.astro';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/nunito';
import '../../styles/v2.css';
import { img, highlights, prices, fmt, contact } from '../../data/site';
import { upcoming, dayLabel, cleanTime, slotsToday, eventPhoto, flightSeason } from '../../data/helpers';
const ev = upcoming(3);
const P = (f: string, w = 700) => `/img/hero/${f}-${w}.webp`;
// Hero: je drei Fotos, wechseln automatisch
const slides = [
  [{ f: 'eule-1', alt: 'Bartkauz' }, { f: 'wolf-1', alt: 'Wolf' }, { f: 'otter-1', alt: 'Fischotter' }],
  [{ f: 'katze-1', alt: 'Junge Wildkatze' }, { f: 'fuchs-1', alt: 'Rotfuchs' }, { f: 'adler-1', alt: 'Seeadler' }],
  [{ f: 'wolf-3', alt: 'Wolf' }, { f: 'eule-2', alt: 'Uhu' }, { f: 'otter-2', alt: 'Fischotter' }],
  [{ f: 'fuchs-2', alt: 'Rotfuchs' }, { f: 'katze-3', alt: 'Wildkatze' }, { f: 'eule-3', alt: 'Schleiereule' }],
];
const feedIcon: Record<string, string> = { '10:30': 'otter', '11:00': 'marder', '13:00': 'fuchs', '14:45': 'storch', '15:00': 'otter', '15:30': 'wolf' };
const pets = [
  { name: 'Wildkatze', note: 'scheu, aber neugierig', f: 'katze-3', tall: true },
  { name: 'Fischotter', note: 'immer in Bewegung', f: 'otter-2' },
  { name: 'Uhu', note: 'unsere größte Eule', f: 'eule-2' },
  { name: 'Rotfuchs', note: 'schlau und flink', f: 'fuchs-2', tall: true },
  { name: 'Wolf', note: 'im großen Rudelgehege', f: 'wolf-2' },
  { name: 'Seeadler', note: 'König der Lüfte', f: 'adler-2' },
];
---
<L title="Wildpark Eekholt: 700 heimische Wildtiere auf 67 Hektar" variant="v2" active="">
  <section class="w-hero pt-target">
    <div class="w-hero-in">
      <div class="w-text">
        <p class="w-pill"><span class="dot"></span><span data-live="status">Täglich geöffnet</span></p>
        <h1>Ein Tag voller Tiere, mitten im Grünen</h1>
        <p class="lede">700 heimische Wildtiere auf 67 Hektar Wald, Wiese und Moor. Zwischen Bad Bramstedt und Bad Segeberg, eine knappe Stunde von Hamburg.</p>
        <div class="w-cta">
          <a class="w-btn lime" href="/v12/besuch/">Besuch planen</a>
          <a class="w-btn line" href="/v12/tiere/">Tiere entdecken</a>
        </div>
      </div>
      <div class="w-photos" data-wphotos>
        {['b1', 'b2', 'b3'].map((cls, k) => (
          <div class={`w-blob ${cls}`} data-depth={[14, 24, 20][k]}>
            {slides.map((sl, i) => <img class={i === 0 ? 'on' : ''} src={P(sl[k].f, k === 0 ? 1200 : 700)} alt={sl[k].alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 && k === 0 ? 'high' : undefined} />)}
          </div>
        ))}
        <span class="w-fact f1" data-depth="34"><b>50</b><small>Jahre</small></span>
        <span class="w-fact f2" data-depth="40"><b>700</b><small>Tiere</small></span>
        <span class="w-fact f3" data-depth="28"><b>67</b><small>Hektar</small></span>
        <span class="w-doodle d1" aria-hidden="true"><Icon name="herz" set="h" /></span>
        <span class="w-doodle d2" aria-hidden="true"><Icon name="blatt" set="h" /></span>
        <span class="w-doodle d3" aria-hidden="true"><Icon name="pfote" set="h" /></span>
        <div class="w-dots" role="group" aria-label="Fotos wechseln">
          {slides.map((sl, i) => <button type="button" data-slide={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={sl.map((x) => x.alt).join(', ')}></button>)}
        </div>
      </div>
    </div>
  </section>

  <section class="w-today">
    <div class="w-wrap">
      <div class="w-head">
        <h2>Heute im Park</h2>
        <p>{flightSeason() ? 'Fütterungen und Flugvorführungen zum Zuschauen' : 'Öffentliche Fütterungen zum Zuschauen. Flugvorführungen wieder ab 14. März 2027.'}</p>
      </div>
      <ol class="w-slots">
        {slotsToday().map((s) => <li data-slot={s.time} data-kind={s.kind}><span class="ic"><Icon name={feedIcon[s.time] || 'adler'} /></span><time>{s.time}</time><span class="what">{s.what}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="w-sec">
    <div class="w-wrap">
      <div class="w-head row">
        <h2>Bald im Wildpark</h2>
        <a class="w-more" href="/v12/veranstaltungen/">Alle 28 Termine 2026</a>
      </div>
      <div class="w-events">
        {ev.map((e) => { const d = dayLabel(e.next); return (
          <a href="/v12/veranstaltungen/">
            <figure><img src={eventPhoto[e.title] ? img(eventPhoto[e.title], 1200) : e.img} alt="" loading="lazy" /><span class="w-date"><b>{d.day}</b><small>{d.monLong.slice(0, 3)}</small></span></figure>
            <div>
              <p class="when">{d.wd} · {cleanTime(e.time)}</p>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          </a>
        ); })}
      </div>
    </div>
  </section>

  <section class="w-sec soft">
    <div class="w-wrap">
      <div class="w-head row">
        <h2>Unsere Lieblinge</h2>
        <a class="w-more" href="/v12/tiere/">Alle Tiere von A bis Z</a>
      </div>
      <div class="w-pets">
        {pets.map((p) => (
          <a class={p.tall ? 'tall' : ''} href="/v12/tiere/">
            <img src={P(p.f)} alt={p.name} loading="lazy" />
            <span><b>{p.name}</b><small>{p.note}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="w-sec">
    <div class="w-wrap w-trio">
      <article class="sage">
        <img src={img('woelfe', 1200)} alt="Zwei Wölfe im Gehege" loading="lazy" />
        <h2>Eekholter Wolfsmeile</h2>
        <p>{highlights.wolfsmeile}</p>
        <a class="w-btn ink" href="/v12/wolfsmeile/">Zur Wolfsmeile</a>
      </article>
      <article class="peach">
        <img src={img('uhu-untersuchung', 1200)} alt="Ein Uhu wird in der Vogelpflegestation untersucht" loading="lazy" />
        <h2>Vogelpflegestation</h2>
        <p>{highlights.pflegestation}</p>
        <p class="tel">{highlights.pflegeTel}</p>
      </article>
      <article class="lime">
        <img src={img('wildkatzen', 1200)} alt="Junge Wildkatzen auf einem Baumstamm" loading="lazy" />
        <h2>Tierpatenschaften</h2>
        <p>{highlights.paten} Firmen können ebenfalls Pate werden.</p>
        <a class="w-btn ink" href={contact.paten} rel="noopener" target="_blank">Pate werden <Ext /></a>
      </article>
    </div>
  </section>

  <section class="w-sec soft">
    <div class="w-wrap">
      <div class="w-head row">
        <h2>Eintritt</h2>
        <a class="w-more" href="/v12/besuch/">Alle Preise, Gruppen und Grillplätze</a>
      </div>
      <div class="w-prices">
        <div><Icon name="ticket" set="h" /><strong>{fmt(prices.single[0].price)}</strong><span>Erwachsene</span></div>
        <div><Icon name="pfote" set="h" /><strong>{fmt(prices.single[2].price)}</strong><span>Kinder 4–16 Jahre</span></div>
        <div><Icon name="herz" set="h" /><strong>{fmt(prices.family.price)}</strong><span>Familien-Tageskarte</span></div>
        <div><Icon name="stern" set="h" /><strong>frei</strong><span>Kinder unter 4 Jahren</span></div>
      </div>
      <div class="w-annual">
        <img src="/img/jahreskarten-2027.webp" alt="Die vier Jahreskarten 2027: Erwachsene, Familien, Großeltern, Kinder" loading="lazy" />
        <div>
          <h3>Jahreskarte 2027: 13 Monate zum Preis von 12</h3>
          <p>{prices.annualNote}</p>
          <a class="w-btn lime" href={contact.shopJk} rel="noopener" target="_blank">Im Onlineshop bestellen <Ext /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="w-sec">
    <div class="w-wrap">
      <div class="w-head"><h2>Für wen planen Sie?</h2></div>
      <div class="w-paths">
        <a href="/v12/besuch/familien/"><img src={img('bachlauf-kinder', 640)} alt="" loading="lazy" /><h3>Familien</h3><p>Spielplätze, Bollerwagen, Fütterungen zum Zuschauen.</p></a>
        <a href="/v12/bildung/"><img src={img('eule-kinder', 640)} alt="" loading="lazy" /><h3>Schulen und Kitas</h3><p>Betreute Programme ab 3,75 € pro Kind, BNE-zertifiziert.</p></a>
        <a href="/v12/besuch/kindergeburtstag/"><img src={img('spielplatz', 640)} alt="" loading="lazy" /><h3>Kindergeburtstag</h3><p>1,5 Stunden mit Betreuung, 65 € zzgl. Eintritt.</p></a>
        <a href="/v12/besuch/essen-und-grillen/"><img src={img('grillkota', 640)} alt="" loading="lazy" /><h3>Feiern und Grillen</h3><p>Grillplätze und Hütten ab 14 € für drei Stunden.</p></a>
      </div>
    </div>
  </section>
  <script>
    const box = document.querySelector<HTMLElement>('[data-wphotos]')!;
    const blobs = [...box.querySelectorAll<HTMLElement>('.w-blob')];
    const dots = [...box.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, t: number | undefined;
    const go = (n: number) => {
      n = (n + dots.length) % dots.length;
      blobs.forEach((b, k) => setTimeout(() => {
        const ims = b.querySelectorAll('img');
        ims.forEach((im, i) => im.classList.toggle('on', i === n));
        (ims[(n + 1) % ims.length] as HTMLImageElement).loading = 'eager';
      }, k * 180));
      dots.forEach((d, i) => d.setAttribute('aria-current', String(i === n)));
      cur = n; clearTimeout(t); if (!reduce) t = window.setTimeout(() => go(cur + 1), 5500);
    };
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    go(0);
    // Fotos und Kreise folgen leicht der Maus
    if (!reduce) {
      const hero = document.querySelector<HTMLElement>('.w-hero')!;
      const movers = [...box.querySelectorAll<HTMLElement>('[data-depth]')];
      hero.addEventListener('mousemove', (e) => {
        const r = hero.getBoundingClientRect(), dx = (e.clientX - r.left) / r.width - .5, dy = (e.clientY - r.top) / r.height - .5;
        movers.forEach((m) => { const k = +m.dataset.depth!; m.style.translate = `${dx * -k}px ${dy * -k}px`; });
      });
      hero.addEventListener('mouseleave', () => movers.forEach((m) => (m.style.translate = '')));
    }
  </script>
</L>
