---
import L from '../../../layouts/V12.astro';
import Icon from '../../../components/Icon.astro';
import Ext from '../../../components/Ext.astro';
import { img, srcset, animals, animalPhotos, highlights, contact } from '../../../data/site';
import aIcons from '../../../data/animalIcons.json';
const a = animals.find((x) => x.slug === 'wolf')!;
const sorted = [...animals].sort((x, y) => x.name.localeCompare(y.name, 'de'));
const icons = aIcons as Record<string, string>;
const related = ['weisses_rotwild', 'otter', 'wildkatze', 'uhu'];
const relName: Record<string, string> = { weisses_rotwild: 'Weißes Rotwild', otter: 'Fischotter', wildkatze: 'Wildkatze', uhu: 'Uhu' };
const bar = (min: number, max: number, scale: number) => `left:${(min / scale) * 100}%;right:${100 - (max / scale) * 100}%`;
const mon = ['J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'];
---
<L title="Wolf (Canis lupus) – Wildpark Eekholt" description="Steckbrief Wolf: Länge, Gewicht, Nahrung und Fortpflanzung. Wölfe erleben Sie im Wildpark Eekholt an der Wolfsmeile, Fütterung täglich 15:30 Uhr." active="tier">
  <section class="page-hero">
    <img src="/img/wolf-hero-2000.webp" srcset="/img/wolf-hero-1200.webp 1200w, /img/wolf-hero-2000.webp 2000w" sizes="100vw" alt="Wolf liegt im Gras und schaut in die Kamera" style="object-position:50% 55%" />
    <div class="plate-h">
      <p class="crumbs"><a href="/v12/">Start</a><span>Unsere Tiere</span><span>Wolf</span></p>
      <h1>{a.name}</h1>
      <p class="latin">{a.latin}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap tier-top">
      <div>
        <div class="notice"><span class="smile"><Icon name="wolf" /></span><div><strong class="hand">Keine Sorge!</strong><p>Das Risiko, von einem Wolf angegriffen zu werden, ist äußerst gering. Normalerweise sind Wölfe scheu und meiden den Menschen.</p></div></div>
        <p>Das Wolfsrudel ist ein Familienverband. Es besteht aus dem Elternpaar, den letztjährigen Jungtieren und den diesjährigen Welpen. Geschlechtsreife Jungtiere wandern ab, in der Natur kommt es so innerhalb des Rudels kaum zu sozialen Auseinandersetzungen.</p>
        <p>Soziale Strukturen mit ranghohen und rangniedrigen Wölfen entstehen nur in Gehegen, wenn mehrere Alttiere zusammen sind.</p>
        <p><a class="more" href="#">Tiersteckbrief als PDF herunterladen</a></p>
      </div>
      <aside class="side-stack">
        <div class="feedcard" data-slot="15:30" data-kind="feed">
          <Icon name="wolf" />
          <span class="when">Öffentliche Fütterung</span>
          <strong>täglich 15:30 Uhr</strong>
          <span>am Wolfsgehege, mit Infos der Tierpfleger</span>
        </div>
        <div class="patencard">
          <h2>Pate für einen Wolf werden</h2>
          <p>{highlights.paten}</p>
          <a class="btn plate" href={contact.paten} rel="noopener" target="_blank">Patenschaft beantragen <Ext /></a>
        </div>
      </aside>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head"><h2>Steckbrief</h2><p>Der Wolf in Zahlen, wie er in Schleswig-Holstein lebt.</p></div>
      <div class="facts12" data-reveal>
        <div class="fact"><Icon name="lineal" set="h" /><h3>Länge</h3><div class="v">100–160 cm</div><span class="bar" aria-hidden="true"><i style={bar(100, 160, 200)}></i></span></div>
        <div class="fact"><Icon name="kiste" set="h" /><h3>Gewicht</h3><div class="v">15–50 kg</div><span class="bar" aria-hidden="true"><i style={bar(15, 50, 60)}></i></span></div>
        <div class="fact"><Icon name="uhr" set="h" /><h3>Lebensalter</h3><div class="v">10–20 Jahre</div><span class="bar" aria-hidden="true"><i style={bar(10, 20, 25)}></i></span></div>
        <div class="fact"><Icon name="herz" set="h" /><h3>Geschlechtsreife</h3><div class="v">1–3 Jahre</div></div>
        <div class="fact wide"><Icon name="besteck" set="h" /><h3>Nahrung</h3><div class="v">Alte, kranke und junge Huftiere, Nager wie der Biber, Haustiere, Früchte und Obst</div></div>
        <div class="fact"><Icon name="kalender" set="h" /><h3>Tragzeit</h3><div class="v">61–63 Tage</div><span class="s">Paarung im Januar und Februar</span></div>
        <div class="fact"><Icon name="pfote" set="h" /><h3>Welpen</h3><div class="v">4 bis 7</div><span class="s">300–500 g, geboren im März oder April, entwöhnt mit 7–9 Wochen</span></div>
        <div class="fact full"><Icon name="blatt" set="h" /><h3>Das Wolfsjahr</h3>
          <div class="cyc" aria-label="Paarung Januar und Februar, Geburt März und April">{mon.map((x, i) => <span class={i < 2 ? 'pair' : i < 4 ? 'birth' : ''}>{x}</span>)}</div>
          <div class="cyc-leg"><span><i style="background:var(--ink)"></i>Paarung</span><span><i style="background:var(--lime)"></i>Geburt der Welpen</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="duo">
    <article>
      <img src={img('wolfsmeile', 640)} alt="Besucher an der Wolfsmeile" loading="lazy" />
      <h2>Mehr über Wölfe in Schleswig-Holstein</h2>
      <p>{highlights.wolfsmeile}</p>
      <a class="btn plate" href="#">Zur Wolfsmeile</a>
    </article>
    <article>
      <img src={img('wolf-portrait', 640)} alt="Wolf schaut in die Kamera" loading="lazy" />
      <h2>Eekholter Wolfsnächte</h2>
      <p>Jedes Jahr im Februar: Wölfe in der Dämmerung erleben, mit Aktionen und Infos vom Wolfsinformationszentrum. Einlass bis 18:00 Uhr.</p>
      <a class="btn plate" href="/v12/veranstaltungen/">Termine ansehen</a>
    </article>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head"><h2>Auch in der Nähe</h2></div>
      <div class="zoo12">
        {related.map((r) => <a href="/v12/tier/"><img src={img(animalPhotos[r], 640)} alt={relName[r]} loading="lazy" /><span class="name">{relName[r]}</span></a>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Alle Tiere von A bis Z</h2><p>33 Tiere mit Steckbrief. Fotos gibt es auf der aktuellen Website bisher nur für einige davon.</p></div>
      <ul class="az12">
        {sorted.map((t) => <li><a href="/v12/tier/" aria-current={t.slug === 'wolf' ? 'page' : undefined}><Icon name={icons[t.slug] || 'pfote'} />{t.name}</a></li>)}
      </ul>
    </div>
  </section>
</L>
