  <script>
    // Hero: drei Fotos je Tier, Icons schalten um, Autoplay alle 6 s
    const hero = document.querySelector<HTMLElement>('[data-hero]')!;
    const frames = [...hero.querySelectorAll<HTMLElement>('.fr')];
    const caps = [...hero.querySelectorAll<HTMLElement>('[data-cap]')];
    const btns = [...hero.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = btns.length / 2, DUR = 6000;
    let cur = 0, timer: number | undefined;
    const pinEls = [...hero.querySelectorAll<HTMLElement>('[data-pin]')];
    const pinTurn = pinEls.map(() => 0);
    function go(i: number) {
      const next = (i + N) % N;
      if (next !== cur) {
        frames.forEach((f) => {
          f.querySelectorAll('img').forEach((im) => im.classList.remove('was'));
          const old = f.querySelector<HTMLImageElement>(`img[data-set="${cur}"]`)!, nu = f.querySelector<HTMLImageElement>(`img[data-set="${next}"]`)!;
          nu.loading = 'eager';
          old.classList.replace('on', 'was');
          nu.classList.add('on');
        });
        cur = next;
      }
      caps.forEach((c) => (c.hidden = +c.dataset.cap! !== cur));
      pinEls.forEach((p) => {
        const on = +p.dataset.pin! === cur;
        if (on && p.classList.contains('act') === false) {
          const ims = [...p.querySelectorAll('img')], o = ims.findIndex((im) => im.classList.contains('on'));
          const n = (o + (pinTurn[cur]++ > 0 ? 1 : 0)) % ims.length;
          ims.forEach((im) => im.classList.remove('was'));
          if (n !== o) { ims[o].classList.replace('on', 'was'); ims[n].classList.add('on'); }
        }
        p.classList.toggle('act', on);
      });
      btns.forEach((b) => { b.setAttribute('aria-current', String(+b.dataset.go! === cur)); const bar = b.querySelector<HTMLElement>('.bar')!; bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; });
      // nächstes Set vorladen
      frames.forEach((f) => { const p = f.querySelector<HTMLImageElement>(`img[data-set="${(cur + 1) % N}"]`); if (p) p.loading = 'eager'; });
      restart();
    }
    function restart() { clearTimeout(timer); if (!reduce) timer = window.setTimeout(() => go(cur + 1), DUR); }
    btns.forEach((b) => b.addEventListener('click', () => go(+b.dataset.go!)));
    go(0);
    const birds = [...hero.querySelectorAll<HTMLElement>('.hx-eagle, .hx-perch')];
    if (!reduce) {
      hero.addEventListener('mousemove', (e) => {
        const r = hero.getBoundingClientRect();
        const dx = (e.clientX - r.left) / r.width - 0.5, dy = (e.clientY - r.top) / r.height - 0.5;
        // nur der Adler folgt der Maus, die Fotos bleiben ruhig
        birds.forEach((b) => { b.style.translate = `${dx * 46}px ${dy * 30}px`; b.style.rotate = `${dx * 6}deg`; });
      });
      hero.addEventListener('mouseleave', () => birds.forEach((b) => { b.style.translate = ''; b.style.rotate = ''; }));
    }
  </script>
</L>
