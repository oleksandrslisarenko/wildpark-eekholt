---
import L from '../../layouts/V12.astro';
import Icon from '../../components/Icon.astro';
import Ext from '../../components/Ext.astro';
import ParkMap from '../../components/ParkMap.astro';
import { img, srcset, highlights, prices, fmt, contact, animals, animalPhotos } from '../../data/site';
import { upcoming, dayLabel, cleanTime, slotsToday, eventPhoto, flightSeason } from '../../data/helpers';
import aIcons from '../../data/animalIcons.json';
const ev = upcoming(3);
import heroPhotos from '../../data/heroPhotos.json';
// Hero: je Tier drei Fotos aus dem Facebook-Auftritt des Parks
const sets = [
  { id: 'eule', icon: 'eule', label: 'Eulen', names: ['Bartkauz', 'Uhu', 'Schleiereule'] },
  { id: 'wolf', icon: 'wolf', label: 'Wolf', names: ['Wolf', 'Wolf', 'Wolf'] },
  { id: 'otter', icon: 'otter', label: 'Fischotter', names: ['Fischotter', 'Fischotter', 'Fischotter'] },
  { id: 'katze', icon: 'katze', label: 'Wildkatze', names: ['Junge Wildkatze', 'Wildkatze mit Jungen', 'Junge Wildkatzen'] },
  { id: 'adler', icon: 'adler', label: 'Seeadler', names: ['Seeadler', 'Seeadler', 'Seeadler'] },
  { id: 'fuchs', icon: 'fuchs', label: 'Rotfuchs', names: ['Rotfuchs', 'Rotfuchs', 'Rotfuchs'] },
];
const hp = heroPhotos as Record<string, { f: string; pos: string }[]>;
const hsrc = (f: string, w: number) => `/img/hero/${f}-${w}.webp`;
import mapShapes from '../../data/mapshapes.json';
// Variante 4: drei verschiedene Naturkanten (objectBoundingBox 0..1)
function edge(kind: string) {
  const B = 0.006, N = 64, pts: string[] = [];
  const env = (u: number) => Math.min(1, u * 7, (1 - u) * 7);
  const w = (side: number, u: number) => {
    const t = 2 * Math.PI * u;
    if (kind === 'wasser') return 0.014 * (1 - Math.cos(t * (side % 2 ? 5 : 7) + side)) / 2 * env(u);
    if (kind === 'krone') { const k = [6, 4, 7, 4][side], a = [0.034, 0.02, 0.016, 0.02][side]; return a * (1 - Math.abs(Math.sin(Math.PI * u * k))) * env(u); }
    return (0.022 * (1 + Math.sin(t * 1.3 + side * 1.7)) / 2 + 0.01 * (1 + Math.sin(t * 3.1 + side)) / 2) * env(u);
  };
  for (let side = 0; side < 4; side++) for (let i = 0; i < N; i++) {
    const u = i / N, d = B + w(side, u), m = B + (1 - 2 * B) * u;
    const [x, y] = side === 0 ? [m, d] : side === 1 ? [1 - d, m] : side === 2 ? [1 - m, 1 - d] : [d, 1 - m];
    pts.push(`${x.toFixed(4)} ${y.toFixed(4)}`);
  }
  return 'M' + pts.join('L') + 'Z';
}
const edges = [edge('krone'), edge('wasser'), edge('huegel')];
// Variante 6: Tiere als Kreise auf dem Parkplan (Kartenkoordinaten, viewBox 40 0 1660 1240)
const pins = [
  { set: 0, at: [772, 396], c: [560, 300], r: 195 },
  { set: 1, at: [1080, 785], c: [1390, 840], r: 225 },
  { set: 2, at: [1103, 566], c: [1010, 470], r: 150 },
  { set: 3, at: [1306, 436], c: [1430, 250], r: 165 },
  { set: 4, at: [744, 912], c: [560, 880], r: 180 },
  { set: 5, at: [1052, 856], c: [1010, 1080], r: 135 },
];
const pct = (v: number, o: number, len: number) => `${(((v - o) / len) * 100).toFixed(2)}%`;
const tiles = [
  { slug: 'wolf', name: 'Wolf', latin: 'Canis lupus', big: true, fb: 'wolf-1' },
  { slug: 'otter', name: 'Fischotter', latin: 'Lutra canadensis', fb: 'otter-1' },
  { slug: 'weisses_rotwild', name: 'Weißes Rotwild', latin: 'Cervus elaphus' },
  { slug: 'wildkatze', name: 'Wildkatze', latin: 'Felis silvestris', fb: 'katze-1' },
  { slug: 'seeadler', name: 'Seeadler', latin: 'Haliaeetus albicilla', fb: 'adler-1' },
  { slug: 'uhu', name: 'Uhu', latin: 'Bubo bubo', fb: 'eule-2' },
  { slug: 'rotfuchs', name: 'Rotfuchs', latin: 'Vulpes vulpes', fb: 'fuchs-1' },
];
// Laufband: alle Tiere mit Icon, zweimal hintereinander für die Endlosschleife
const icons = aIcons as Record<string, string>;
const seen = new Set<string>();
const band = [...animals].sort(() => 0.5 - Math.random()).filter((a) => { const i = icons[a.slug]; if (seen.has(i)) return false; seen.add(i); return true; }).map((a) => ({ name: a.name, icon: icons[a.slug] }));
const feedIcon: Record<string, string> = { '10:30': 'otter', '11:00': 'marder', '13:00': 'fuchs', '14:45': 'storch', '15:00': 'otter', '15:30': 'wolf' };
---
<L title="Wildpark Eekholt – Naturerlebnisse im Norden Hamburgs" active="">
  <section class="hx hv4 pt-holz" data-hero>
    <div class="hx-plate">
      <img class="hx-eagle" src="/img/eagle.svg" alt="" />
      <h1>700 heimische Wildtiere auf 67 Hektar Natur</h1>
      <div class="hx-txt">
        <p class="lede">Zwischen Bad Bramstedt und Bad Segeberg, eine knappe Stunde von Hamburg. Täglich und ganzjährig geöffnet.</p>
        <div class="row">
          <a class="btn ink" href="/v12/besuch/">Preise und Öffnungszeiten</a>
          <span class="live" data-live="status">Täglich geöffnet</span>
        </div>
      </div>
    </div>
    <div class="h12-nav hx-nav" role="group" aria-label="Tiere im Wildpark">
      <ul>
        {sets.map((s, i) => <li><button type="button" data-go={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={s.label} title={s.label}><Icon name={s.icon} /><span class="bar"></span></button></li>)}
        <li><a class="all" href="/v12/tier/">Alle Tiere</a></li>
      </ul>
    </div>
    <div class="hx-frames" data-frames>
      {[0, 1, 2, 3].map((slot) => (
        <figure class={`fr fr${slot + 1}`} style={`--i:${slot}`}>
          {sets.map((s, k) => { const ph = hp[s.id][slot]; return (
            <img class={k === 0 ? 'on' : ''} data-set={k} src={hsrc(ph.f, slot === 0 ? 1200 : 700)} srcset={`${hsrc(ph.f, 700)} 700w, ${hsrc(ph.f, 1200)} 1200w`} sizes={slot === 0 ? '(max-width: 900px) 100vw, 45vw' : '(max-width: 900px) 50vw, 25vw'} style={`object-position:${ph.pos}`} alt={s.names[slot]} loading={k === 0 ? 'eager' : 'lazy'} fetchpriority={k === 0 && slot === 0 ? 'high' : undefined} />
          ); })}
        </figure>
      ))}
      <svg class="hx-defs" width="0" height="0" aria-hidden="true"><defs>{edges.map((d, k) => <clipPath id={`edge${k + 1}`} clipPathUnits="objectBoundingBox"><path d={d} /></clipPath>)}<clipPath id="wellkreis" clipPathUnits="objectBoundingBox"><path d="M0.9910 0.5000L0.9867 0.5085L0.9832 0.5169L0.9814 0.5252L0.9815 0.5337L0.9834 0.5423L0.9864 0.5511L0.9898 0.5601L0.9924 0.5692L0.9934 0.5781L0.9923 0.5868L0.9889 0.5950L0.9839 0.6028L0.9778 0.6103L0.9718 0.6176L0.9667 0.6251L0.9633 0.6329L0.9618 0.6412L0.9619 0.6501L0.9631 0.6594L0.9643 0.6690L0.9646 0.6784L0.9633 0.6872L0.9600 0.6953L0.9547 0.7024L0.9478 0.7088L0.9402 0.7147L0.9328 0.7205L0.9264 0.7267L0.9216 0.7337L0.9185 0.7416L0.9168 0.7504L0.9159 0.7599L0.9149 0.7694L0.9129 0.7785L0.9095 0.7867L0.9042 0.7936L0.8971 0.7993L0.8889 0.8038L0.8801 0.8078L0.8717 0.8119L0.8643 0.8167L0.8582 0.8226L0.8536 0.8298L0.8502 0.8381L0.8472 0.8472L0.8440 0.8562L0.8399 0.8646L0.8345 0.8715L0.8276 0.8769L0.8193 0.8806L0.8102 0.8830L0.8008 0.8850L0.7917 0.8871L0.7836 0.8903L0.7765 0.8949L0.7706 0.9012L0.7654 0.9087L0.7605 0.9169L0.7553 0.9250L0.7494 0.9320L0.7424 0.9373L0.7343 0.9407L0.7253 0.9422L0.7158 0.9424L0.7062 0.9422L0.6970 0.9424L0.6884 0.9439L0.6807 0.9472L0.6736 0.9521L0.6669 0.9585L0.6603 0.9654L0.6534 0.9720L0.6459 0.9773L0.6378 0.9806L0.6291 0.9818L0.6199 0.9810L0.6106 0.9790L0.6013 0.9767L0.5923 0.9750L0.5837 0.9748L0.5755 0.9765L0.5675 0.9800L0.5595 0.9849L0.5515 0.9902L0.5433 0.9949L0.5348 0.9981L0.5262 0.9993L0.5174 0.9982L0.5086 0.9951L0.5000 0.9910L0.4915 0.9867L0.4831 0.9832L0.4748 0.9814L0.4663 0.9815L0.4577 0.9834L0.4489 0.9864L0.4399 0.9898L0.4308 0.9924L0.4219 0.9934L0.4132 0.9923L0.4050 0.9889L0.3972 0.9839L0.3897 0.9778L0.3824 0.9718L0.3749 0.9667L0.3671 0.9633L0.3588 0.9618L0.3499 0.9619L0.3406 0.9631L0.3310 0.9643L0.3216 0.9646L0.3128 0.9633L0.3047 0.9600L0.2976 0.9547L0.2912 0.9478L0.2853 0.9402L0.2795 0.9328L0.2733 0.9264L0.2663 0.9216L0.2584 0.9185L0.2496 0.9168L0.2401 0.9159L0.2306 0.9149L0.2215 0.9