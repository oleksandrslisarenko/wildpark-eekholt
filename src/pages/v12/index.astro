.0007L0.4826 0.0018L0.4914 0.0049L0.5000 0.0090L0.5085 0.0133L0.5169 0.0168L0.5252 0.0186L0.5337 0.0185L0.5423 0.0166L0.5511 0.0136L0.5601 0.0102L0.5692 0.0076L0.5781 0.0066L0.5868 0.0077L0.5950 0.0111L0.6028 0.0161L0.6103 0.0222L0.6176 0.0282L0.6251 0.0333L0.6329 0.0367L0.6412 0.0382L0.6501 0.0381L0.6594 0.0369L0.6690 0.0357L0.6784 0.0354L0.6872 0.0367L0.6953 0.0400L0.7024 0.0453L0.7088 0.0522L0.7147 0.0598L0.7205 0.0672L0.7267 0.0736L0.7337 0.0784L0.7416 0.0815L0.7504 0.0832L0.7599 0.0841L0.7694 0.0851L0.7785 0.0871L0.7867 0.0905L0.7936 0.0958L0.7993 0.1029L0.8038 0.1111L0.8078 0.1199L0.8119 0.1283L0.8167 0.1357L0.8226 0.1418L0.8298 0.1464L0.8381 0.1498L0.8472 0.1528L0.8562 0.1560L0.8646 0.1601L0.8715 0.1655L0.8769 0.1724L0.8806 0.1807L0.8830 0.1898L0.8850 0.1992L0.8871 0.2083L0.8903 0.2164L0.8949 0.2235L0.9012 0.2294L0.9087 0.2346L0.9169 0.2395L0.9250 0.2447L0.9320 0.2506L0.9373 0.2576L0.9407 0.2657L0.9422 0.2747L0.9424 0.2842L0.9422 0.2938L0.9424 0.3030L0.9439 0.3116L0.9472 0.3193L0.9521 0.3264L0.9585 0.3331L0.9654 0.3397L0.9720 0.3466L0.9773 0.3541L0.9806 0.3622L0.9818 0.3709L0.9810 0.3801L0.9790 0.3894L0.9767 0.3987L0.9750 0.4077L0.9748 0.4163L0.9765 0.4245L0.9800 0.4325L0.9849 0.4405L0.9902 0.4485L0.9949 0.4567L0.9981 0.4652L0.9993 0.4738L0.9982 0.4826L0.9951 0.4914Z" /></clipPath><clipPath id="fernglas" clipPathUnits="objectBoundingBox"><ellipse cx=".255" cy=".5" rx=".255" ry=".497" /><ellipse cx=".745" cy=".5" rx=".255" ry=".497" /><rect x=".36" y=".2" width=".28" height=".46" rx=".04" /></clipPath></defs></svg>
      <div class="hx-plan" aria-hidden="true">
        <svg viewBox="40 0 1660 1240" preserveAspectRatio="xMidYMid meet">
          <defs>
            <pattern id="bphatch" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><path d="M0 0V14" /></pattern>
          </defs>
          <path class="road" d="M330 358 L940 300 L1046 232" /><path class="road" d="M520 1225 C560 1060 640 990 760 958 L1565 850" />
          <path class="park" d={mapShapes.park} />
          <path class="moor" d={mapShapes.moor} />
          <path class="water" d={mapShapes.water} />
          <path class="paths" d={mapShapes.paths} />
          {pins.map((p) => <g class="lead"><path d={`M${p.at[0]} ${p.at[1]} L${p.c[0]} ${p.c[1]}`} /><circle cx={p.at[0]} cy={p.at[1]} r="9" /></g>)}
        </svg>
        {pins.map((p, k) => (
          <figure class="pin" data-pin={p.set} style={`left:${pct(p.c[0], 40, 1660)};top:${pct(p.c[1], 0, 1240)};width:${pct(2 * p.r, 0, 1660)};--i:0`}>
            <span class="disc">{hp[sets[p.set].id].map((ph, j) => <img class={j === 0 ? 'on' : ''} src={hsrc(ph.f, 700)} style={`object-position:${ph.pos}`} alt="" loading="lazy" />)}</span>
            <figcaption>{sets[p.set].label}</figcaption>
          </figure>
        ))}
      </div>
      <svg class="hx-trail" viewBox="0 0 600 600" preserveAspectRatio="none" aria-hidden="true"><path d="M50 462 C 38 425, 46 388, 66 362" /><path class="tip" d="M54 366 L66 361 L68 374" /></svg>
      <p class="hx-hand" aria-hidden="true">{sets.map((s, k) => <span data-cap={k} hidden={k !== 0}>{s.label}</span>)}</p>
      <p class="hx-cap">{sets.map((s, k) => <span data-cap={k} hidden={k !== 0}>{[...new Set(s.names)].join(', ')}</span>)}<span> · Fotos: Wildpark Eekholt</span></p>
    </div>
    <div class="hx-thumbs" role="group" aria-label="Tiere im Wildpark">
      {sets.map((s, i) => <button type="button" data-go={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={s.label} title={s.label}><img src={hsrc(hp[s.id][0].f, 700)} style={`object-position:${hp[s.id][0].pos}`} alt="" loading="lazy" /><svg viewBox="0 0 100 100" aria-hidden="true"><circle class="bar" cx="50" cy="50" r="47" pathLength="100" /></svg></button>)}
      <a class="all" href="/v12/tier/">Alle Tiere</a>
    </div>
    <p class="hx-note" aria-hidden="true">{sets.map((s, k) => <span data-cap={k} hidden={k !== 0}>{s.label}</span>)}</p>
  </section>

  <section class="today" aria-labelledby="today-h">
    <div class="wrap">
      <div>
        <h2 id="today-h">Heute im Park</h2>
        <p class="sub">{flightSeason() ? 'Fütterungen und Flugvorführungen' : `Öffentliche Fütterungen. Flugvorführungen wieder ab 14. März 2027.`}</p>
      </div>
      <ol class="slots">
        {slotsToday().map((s) => <li data-slot={s.time} data-kind={s.kind}><Icon name={feedIcon[s.time] || 'adler'} /><time>{s.time}</time><span>{s.what}</span></li>)}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head">
        <h2>Als Nächstes im Wildpark</h2>
        <a class="more" href="/v12/veranstaltungen/">Alle 28 Termine 2026</a>
      </div>
      <div class="ev3">
        {ev.map((e) => { const d = dayLabel(e.next); return (
          <a href="/v12/veranstaltungen/">
            <figure><img src={eventPhoto[e.title] ? img(eventPhoto[e.title], 1200) : e.img} alt="" loading="lazy" /><span class="date"><i>{d.wd}</i><b data-i18n-daymonth={`${d.day}|${d.monLong}`}>{d.day}<small>{d.monLong}</small></b><span>{cleanTime(e.time)}</span></span></figure>
            <div class="body">
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          </a>
        ); })}
      </div>
      <p class="pnote">Alle Sonderveranstaltungen sind im Eintritt enthalten und auch mit der Jahreskarte nutzbar.</p>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head">
        <h2>Über 100 Arten, fast alle von hier</h2>
        <p>Wolf, Fischotter, Wildkatze, Seeadler: Tiere, die in Schleswig-Holstein leben oder lebten. 33 davon stellen sich mit Steckbrief vor.</p>
      </div>
      <div class="zoo12">
        {tiles.map((t) => (
          <a class={t.big ? 'big' : ''} href="/v12/tier/">
            <img src={t.fb ? hsrc(t.fb, t.big ? 1200 : 700) : img(animalPhotos[t.slug], t.big ? 1200 : 640)} alt={t.name} loading="lazy" />
            <span class="name">{t.name}<small>{t.latin}</small></span>
          </a>
        ))}
      </div>
      <div class="ticker" aria-label="Alle Tiere des Parks">
        <ul>
          {[...band, ...band].map((b, i) => (
            <li aria-hidden={i >= band.length ? 'true' : undefined}><a href="/v12/tier/" tabindex={i >= band.length ? -1 : undefined} aria-label={b.name}><Icon name={b.icon} /><span class="tip">{b.name}</span></a></li>
          ))}
        </ul>
      </div>
      <p><a class="more" href="/v12/tier/">Alle Tiere von A bis Z</a></p>
    </div>
  </section>

  <section class="trio">
    <article>
      <img src={img('woelfe', 1200)} alt="Zwei Wölfe im Gehege" loading="lazy" />
      <h2>Eekholter Wolfsmeile</h2>
      <p>{highlights.wolfsmeile}</p>
      <a class="btn plate" href="#">Zur Wolfsmeile</a>
    </article>
    <article>
      <img src={img('uhu-untersuchung', 1200)} alt="Ein Uhu wird in der Vogelpflegestation untersucht" loading="lazy" />
      <h2>Vogelpflegestation</h2>
      <p>{highlights.pflegestation}</p>
      <p class="tel">{highlights.pflegeTel}</p>
    </article>
    <article>
      <img src={img('wildkatzen', 1200)} alt="Junge Wildkatzen auf einem Baumstamm" loading="lazy" />
      <h2>Tierpatenschaften</h2>
      <p>{highlights.paten} Firmen können ebenfalls Pate werden.</p>
      <a class="btn plate" href={contact.paten} rel="noopener" target="_blank">Pate werden <Ext /></a>
    </article>
  </section>

  <section class="mapsec">
    <div class="wrap">
      <div class="head">
        <h2>Der Park auf einen Blick</h2>
