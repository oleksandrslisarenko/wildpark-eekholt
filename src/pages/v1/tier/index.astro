---
import L from '../../../layouts/V1.astro';
import { img, srcset, animals, animalPhotos, highlights, contact } from '../../../data/site';
const a = animals.find((x) => x.slug === 'wolf')!;
const sorted = [...animals].sort((x, y) => x.name.localeCompare(y.name, 'de'));
const main = a.facts.filter((f) => ['Länge', 'Gewicht', 'Lebensalter', 'Nahrung'].includes(f.k));
const repro = a.facts.filter((f) => ['Tragzeit', 'Geburt', 'Geschlechtsreife'].includes(f.k));
// Balken: Wertebereich relativ zum Maximum
const bars: Record<string, [number, number, number]> = { Länge: [100, 160, 180], Gewicht: [15, 50, 60], Lebensalter: [10, 20, 24] };
const related = ['weisses_rotwild', 'otter', 'wildkatze', 'uhu'];
const relName: Record<string, string> = { weisses_rotwild: 'Weißes Rotwild', otter: 'Fischotter', wildkatze: 'Wildkatze', uhu: 'Uhu' };
---
<L title="Wolf (Canis lupus) – Wildpark Eekholt" description="Steckbrief Wolf: Länge, Gewicht, Nahrung und Fortpflanzung. Wölfe erleben Sie im Wildpark Eekholt an der Wolfsmeile, Fütterung täglich 15:30 Uhr." active="tier">
  <section class="page-hero">
    <img src={img('woelfe', 2000)} srcset={srcset('woelfe')} sizes="100vw" alt="Zwei Wölfe laufen durch hohes Gras" />
    <div class="plate-h">
      <p class="crumbs"><a href="/v1/">Start</a><span>Unsere Tiere</span><span>Wolf</span></p>
      <h1>{a.name}</h1>
      <p class="latin">{a.latin}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <p class="lead">Das Risiko, von einem Wolf angegriffen zu werden, ist äußerst gering. Normalerweise sind Wölfe scheu und meiden den Menschen.</p>
        <p>Das Wolfsrudel ist ein Familienverband. Es besteht aus dem Elternpaar, den letztjährigen Jungtieren und den diesjährigen Welpen. Geschlechtsreife Jungtiere wandern ab, in der Natur kommt es so innerhalb des Rudels kaum zu sozialen Auseinandersetzungen.</p>
        <p>Soziale Strukturen mit ranghohen und rangniedrigen Wölfen entstehen nur in Gehegen, wenn mehrere Alttiere zusammen sind.</p>
        <p><a class="more" href="#">Tiersteckbrief als PDF herunterladen</a></p>
      </div>
      <aside>
        <section class="steck" data-reveal>
          <h2>Steckbrief</h2>
          <dl>
            {main.map((f) => (
              <div><dt>{f.k}</dt><dd>{f.v.replace('alte. kranke', 'alte, kranke')}
                {bars[f.k] && <span class="bar" aria-hidden="true"><i style={`left:${bars[f.k][0] / bars[f.k][2] * 100}%;right:${100 - bars[f.k][1] / bars[f.k][2] * 100}%`}></i></span>}
              </dd></div>
            ))}
            <div><dt>Fortpflanzung</dt><dd></dd></div>
            {repro.map((f) => <div class="sub"><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
        </section>
        <div class="feedbox">
          <span>Öffentliche Fütterung</span>
          <strong>täglich 15:30 Uhr</strong>
          <span data-slot="15:30" data-kind="feed">am Wolfsgehege, mit Infos der Tierpfleger</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="duo">
    <article>
      <img src={img('wolfsmeile', 640)} alt="Besucher an der Wolfsmeile" loading="lazy" />
      <h2>Mehr über Wölfe in Schleswig-Holstein</h2>
      <p>{highlights.wolfsmeile}</p>
      <a class="btn plate" href="#">Zur Wolfsmeile</a>
    </article>
    <article>
      <img src={img('wolf-portrait', 640)} alt="Wolf schaut in die Kamera" loading="lazy" />
      <h2>Eekholter Wolfsnächte</h2>
      <p>Jedes Jahr im Februar: Wölfe in der Dämmerung erleben, mit Aktionen und Infos vom Wolfsinformationszentrum. Einlass bis 18:00 Uhr.</p>
      <a class="btn plate" href="/v1/veranstaltungen/">Termine ansehen</a>
    </article>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="paten">
        <div><h2>Pate für einen Wolf werden</h2><p>{highlights.paten}</p></div>
        <a class="btn plate" href={contact.paten} rel="noopener">Patenschaft beantragen</a>
      </div>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head"><h2>Auch in der Nähe</h2></div>
      <div class="animals">
        {related.map((r) => (
          <a class="a-tile" href="/v1/tier/" style="grid-column:span 3"><img src={img(animalPhotos[r], 640)} alt={relName[r]} loading="lazy" /><span class="name">{relName[r]}</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Alle Tiere von A bis Z</h2><p>Mit Punkt markiert: Tiere mit Foto. Für alle anderen fehlen auf der aktuellen Website Bilder.</p></div>
      <ul class="index-az">
        {sorted.map((t) => <li><a href="/v1/tier/" class={animalPhotos[t.slug] ? 'photo' : ''} aria-current={t.slug === 'wolf' ? 'page' : undefined}>{t.name}</a></li>)}
      </ul>
    </div>
  </section>
</L>
