---
import L from '../../../layouts/V1.astro';
import { prices, fmt, seasons, specialEntry, contact, flights, feedings } from '../../../data/site';
import { TODAY } from '../../../data/helpers';
const m = TODAY.getMonth() + 1;
const cur = m >= 3 && m <= 10 ? 'sommer' : 'winter';
---
<L title="Preise und Öffnungszeiten – Wildpark Eekholt" description="Eintrittspreise, Jahreskarten, Gruppenpreise und Einlasszeiten des Wildpark Eekholt. Täglich und ganzjährig geöffnet." active="besuch">
  <section class="plain-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/v1/">Start</a><span>Besuch planen</span></p>
      <h1>Preise und Öffnungszeiten</h1>
      <p>Täglich und ganzjährig geöffnet, auch an Feiertagen. Nach dem letzten Einlass können Sie bis zur Dunkelheit bleiben und den Park durch das Drehtor verlassen.</p>
      <p class="live" data-live="status" style="margin-top:18px">Täglich geöffnet</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="hours">
        {seasons.map((s) => (
          <article class={s.id === cur ? 'current' : ''}>
            <h3>{s.label}</h3>
            <div class="big">{s.open}–{s.lastEntry}</div>
            <p>Einlass täglich. Spaziergang bis Einbruch der Dunkelheit.</p>
          </article>
        ))}
      </div>
      <p class="pnote">{specialEntry}</p>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap pgrid">
      <div>
        <table class="ptable">
          <caption>Tageskarten</caption>
          <tbody>{prices.single.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody>
        </table>
        <div class="family"><div><b>{prices.family.label}</b><br /><span>{prices.family.note}</span></div><strong>{fmt(prices.family.price)}</strong></div>
      </div>
      <div>
        <table class="ptable">
          <caption>Gruppen ab 20 Personen</caption>
          <tbody>{prices.groups.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody>
        </table>
        <p class="pnote">{prices.groupsNote}</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Jahreskarten 2027</h2><p>{prices.annualNote}</p></div>
      <div class="annual">
        {prices.annual.map((a) => <div class={a.color}><h3>{a.label}</h3><span>{a.note || 'ab 16 Jahren'}</span><strong>{fmt(a.price)}</strong></div>)}
      </div>
      <p style="margin-top:20px"><a class="btn ink" href={contact.shop} rel="noopener">Jahreskarte im Onlineshop bestellen</a></p>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap pgrid">
      <div>
        <table class="ptable">
          <caption>Schulklassen und Kitas</caption>
          <tbody>{prices.schools.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody>
        </table>
        <p class="pnote">{prices.schoolsNote}</p>
      </div>
      <div>
        <table class="ptable">
          <caption>Führungen, Geburtstage, Grillen</caption>
          <tbody>{prices.extras.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}{p.extra && <small>{p.extra}</small>}</td></tr>)}</tbody>
        </table>
        <p class="pnote">Grillplätze und Führungen bitte vorher anmelden: <a href={contact.phoneHref}>{contact.phone}</a>, {contact.office}.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap pgrid">
      <div>
        <div class="head"><h2>Fütterungen</h2></div>
        <table class="ptable"><tbody>{feedings.map((f) => <tr data-slot={f.time} data-kind="feed"><th>{f.what}</th><td>{f.time} Uhr</td></tr>)}</tbody></table>
        <p class="pnote">Abweichungen sind möglich. Die Tafel am Eingang zeigt die Fütterungen des Tages.</p>
      </div>
      <div>
        <div class="head"><h2>Flugvorführungen</h2></div>
        <p style="font-size:22px;font-weight:700">{flights.times.join(' · ')} Uhr</p>
        <p>{flights.season}, auf der Flugwiese mit Sitzplätzen. {flights.note} Nächster Start: 14. März 2027.</p>
      </div>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head"><h2>Gut zu wissen</h2></div>
      <ul class="rules">{prices.rules.map((r) => <li>{r}</li>)}</ul>
    </div>
  </section>
</L>
