---
import L from '../../../layouts/V12.astro';
import Icon from '../../../components/Icon.astro';
import Ext from '../../../components/Ext.astro';
import { prices, fmt, seasons, specialEntry, contact, flights, feedings, img } from '../../../data/site';
import { TODAY } from '../../../data/helpers';
const m = TODAY.getMonth() + 1;
const cur = m >= 3 && m <= 10 ? 'sommer' : 'winter';
const ordered = [...seasons].sort((a, b) => (a.id === cur ? -1 : b.id === cur ? 1 : 0));
const feedIcon: Record<string, string> = { 'Fischotter': 'otter', 'Baummarder': 'marder', 'Füchse, Dachse und Steinmarder': 'fuchs', 'Störche': 'storch', 'Wolf': 'wolf' };
const ruleIcons = ['hund', 'pfote', 'verbot', 'karre'];
export function getStaticPaths() { return ['v12', 'v3'].map((v) => ({ params: { v } })); }
---
<L variant={Astro.params.v as any} title="Preise und Öffnungszeiten – Wildpark Eekholt" description="Eintrittspreise, Jahreskarten, Gruppenpreise und Einlasszeiten des Wildpark Eekholt. Täglich und ganzjährig geöffnet." active="besuch">
  <section class="ph12">
    <div class="wrap">
      <div>
        <p class="crumbs"><a href="/v12/">Start</a><span>Besuch planen</span></p>
        <h1>Preise und Öffnungszeiten</h1>
        <p>Täglich und ganzjährig geöffnet, auch an Feiertagen. Nach dem letzten Einlass können Sie bis zur Dunkelheit bleiben und den Park durch das Drehtor verlassen.</p>
        <p class="live" data-live="status" style="margin-top:18px">Täglich geöffnet</p>
      </div>
      <div class="illu" aria-hidden="true"><Icon name="szene-besuch" set="h" cls="scene" /></div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="hours">
        {ordered.map((s) => (
          <article class={s.id === cur ? 'current' : ''}>
            <h3>{s.label}</h3>
            <div class="big">{s.open}–{s.lastEntry}</div>
            <p>Einlass täglich. Spaziergang bis Einbruch der Dunkelheit.</p>
          </article>
        ))}
      </div>
      <p class="pnote">{specialEntry}</p>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="pgrid">
        <div>
          <div class="blockhead"><Icon name="ticket" set="h" /><h2>Tageskarten</h2></div>
          <table class="ptable">
            <caption class="hidden">Tageskarten</caption>
            <tbody>{prices.single.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody>
          </table>
          <div class="family"><div><b>{prices.family.label}</b><br /><span>{prices.family.note}</span></div><strong>{fmt(prices.family.price)}</strong></div>
        </div>
        <div>
          <div class="blockhead"><Icon name="gruppe" set="h" /><h2>Gruppen ab 20 Personen</h2></div>
          <table class="ptable">
            <caption class="hidden">Gruppen ab 20 Personen</caption>
            <tbody>{prices.groups.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody>
          </table>
          <p class="pnote">{prices.groupsNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2>Jahreskarten 2027</h2><p>{prices.annualNote}</p></div>
      <div class="annual12">
        {prices.annual.map((a) => (
          <a href={a.href} rel="noopener" target="_blank">
            <div class="card"><img src={`/img/jk-${a.img}.webp`} alt={`Jahreskarte 2027 ${a.label}`} loading="lazy" /></div>
            <div class="meta">
              <h3><i style={`background:var(--jk-${a.color})`}></i>{a.label}</h3>
              <span>{a.note || 'ab 16 Jahren'}</span>
              <b class="price">{fmt(a.price)}</b>
            </div>
            <span class="buy">Im Onlineshop bestellen <Ext /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap pgrid">
      <div>
        <div class="blockhead"><Icon name="buch" set="h" /><h2>Schulklassen und Kitas</h2></div>
        <table class="ptable"><caption class="hidden">Schulklassen und Kitas</caption><tbody>{prices.schools.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}</td></tr>)}</tbody></table>
        <p class="pnote">{prices.schoolsNote}</p>
      </div>
      <div>
        <div class="blockhead"><Icon name="feuer" set="h" /><h2>Führungen, Geburtstage, Grillen</h2></div>
        <table class="ptable"><caption class="hidden">Führungen, Geburtstage, Grillen</caption><tbody>{prices.extras.map((p) => <tr><th>{p.label}</th><td>{fmt(p.price)}{p.extra && <small>{p.extra}</small>}</td></tr>)}</tbody></table>
        <p class="pnote">Grillplätze und Führungen bitte vorher anmelden: <a href={contact.phoneHref}>{contact.phone}</a>, {contact.office}.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap pgrid">
      <div>
        <div class="blockhead"><Icon name="teller" set="h" /><h2>Fütterungen</h2></div>
        <table class="ptable"><caption class="hidden">Fütterungen</caption><tbody>{feedings.map((f) => <tr data-slot={f.time} data-kind="feed"><th><span class="anim"><Icon name={feedIcon[f.what] || 'pfote'} />{f.what}</span></th><td>{f.time} Uhr</td></tr>)}</tbody></table>
        <p class="pnote">Abweichungen sind möglich. Die Tafel am Eingang zeigt die Fütterungen des Tages.</p>
      </div>
      <div>
        <div class="blockhead"><Icon name="vogel" set="h" /><h2>Flugvorführungen</h2></div>
        <p style="font-size:24px;font-weight:700">{flights.times.join(' · ')} Uhr</p>
        <p>{flights.season}, auf der Flugwiese mit Sitzplätzen. {flights.note} Nächster Start: 14. März 2027.</p>
        <figure style="margin:20px 0 0"><img src={img('flugwiese', 640)} alt="Flugvorführung auf der Flugwiese" loading="lazy" style="width:100%;aspect-ratio:16/9;object-fit:cover" /></figure>
      </div>
    </div>
  </section>

  <section class="sec mist">
    <div class="wrap">
      <div class="head"><h2>Gut zu wissen</h2></div>
      <ul class="rules12">{prices.rules.map((r, i) => <li><Icon name={ruleIcons[i]} set="h" />{r}</li>)}</ul>
    </div>
  </section>
</L>
