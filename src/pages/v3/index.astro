---
import L from '../../layouts/V3.astro';
import { img, highlights, prices, fmt, contact, animalPhotos } from '../../data/site';
import { upcoming, dayLabel, cleanTime, slotsToday, eventPhoto, flightSeason } from '../../data/helpers';
import { cats, catOf } from '../../data/categories';
const ev = upcoming(3);
const cards = [
  { color: 'red', who: 'Familien', line: 'Spielplätze, Bollerwagen, Fütterungen', photo: 'bachlauf-kinder' },
  { color: 'orange', who: 'Kinder', line: 'Kinderseite, Geburtstage, Rallyes', photo: 'wildkatzen' },
  { color: 'purple', who: 'Best Ager', line: 'Ruhige Rundwege, Bänke, Führungen', photo: 'weisses-rotwild' },
  { color: 'blue', who: 'Schulen & Gruppen', line: 'Bildungsprogramme, Gruppenpreise', photo: 'fischotter' },
];
const zoo = [
  ['wolf', 'Wolf'], ['otter', 'Fischotter'], ['wildkatze', 'Wildkatze'], ['storch', 'Weißstorch'], ['weisses_rotwild', 'Weißes Rotwild'],
  ['uhu', 'Uhu'], ['kampflaeufer', 'Kampfläufer'], ['seeadler', 'Seeadler'],
];
---
<L title="Wildpark Eekholt – Naturerlebnisse im Norden Hamburgs">
  <section class="hero">
    <div class="wrap">
      <div class="copy">
        <h1><span class="it">NaturErlebnisse</span>im Wildpark Eekholt</h1>
        <p class="lede">700 heimische Tiere, 67 Hektar Wald und Wiese. Das ganze Jahr geöffnet, eine knappe Stunde von Hamburg.</p>
        <a class="btn ink" href="/v3/besuch/">Preise und Öffnungszeiten</a>
      </div>
      <div class="fan" aria-label="Angebote nach Besuchergruppe">
        {cards.map((c) => (
          <a class={`jk ${c.color}`} href="#">
            <div class="band"><small>Wildpark für</small><b>{c.who}</b><span>{c.line}</span></div>
            <img src={img(c.photo, 640)} alt="" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="today">
    <div class="wrap">
      <h2>Heute</h2>
      <ul class="chips">{slotsToday().map((s) => <li data-slot={s.time} data-kind={s.kind}><b>{s.time}</b>{s.what}</li>)}</ul>
      <p class="note">{flightSeason() ? '' : 'Flugvorführungen wieder ab 14. März 2027'}</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="rowhead"><h2 class="h2"><span class="it">Demnächst</span>Was im Park los ist</h2><a class="link" href="/v3/veranstaltungen/">Alle Termine</a></div>
      <div class="evcards">
        {ev.map((e) => { const d = dayLabel(e.next); const c = cats[catOf(e.title)]; return (
          <a class={`ec ${c.color}`} href="/v3/veranstaltungen/">
            <div class="top-b"><div class="day">{d.day}.<small>{d.monLong}</small></div><div class="cat">{c.label}</div></div>
            <img src={eventPhoto[e.title] ? img(eventPhoto[e.title], 640) : e.img} alt="" loading="lazy" />
            <div class="body"><h3>{e.title}</h3><p>{cleanTime(e.time)}</p></div>
          </a>
        ); })}
      </div>
      <p class="pnote">Alle Sonderveranstaltungen sind im Eintritt enthalten und auch mit der Jahreskarte nutzbar.</p>
    </div>
  </section>

  <section class="sec warm">
    <div class="wrap">
      <div class="rowhead"><h2 class="h2"><span class="it">Über 100 Arten</span>Unsere Tiere</h2><a class="link" href="/v3/tier/">Alle 33 Steckbriefe</a></div>
      <div class="zoo">{zoo.map(([s, n]) => <a href="/v3/tier/"><img src={img(animalPhotos[s], 640)} alt={n} loading="lazy" /><span>{n}</span></a>)}</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap blocks">
      <article class="block"><img src={img('woelfe', 1200)} alt="Wölfe" loading="lazy" /><div><h3>Eekholter Wolfsmeile</h3><p>{highlights.wolfsmeile}</p><a class="btn lime" href="#">Zur Wolfsmeile</a></div></article>
      <article class="block"><img src={img('uhu-untersuchung', 1200)} alt="Uhu in der Pflegestation" loading="lazy" /><div><h3>Vogelpflegestation</h3><p>{highlights.pflegestation}</p><p class="tel">{highlights.pflegeTel}</p></div></article>
    </div>
  </section>

  <section class="sec warm">
    <div class="wrap pband">
      <div>
        <h2 class="h2"><span class="it">Eintritt</span>Was ein Tag im Park kostet</h2>
        <div class="ptiles">
          <div><b>{fmt(prices.single[0].price)}</b><span>Erwachsene</span></div>
          <div><b>{fmt(prices.single[2].price)}</b><span>Kinder 4–16 Jahre</span></div>
          <div class="fam"><span>Familien-Tageskarte<br />Eltern mit eigenen Kindern bis 16</span><b>{fmt(prices.family.price)}</b></div>
        </div>
        <p class="pnote">Kinder unter 4 Jahren frei. <a href="/v3/besuch/">Alle Preise, Gruppen und Grillplätze</a></p>
      </div>
      <div class="jkpromo">
        <img src="/img/jahreskarten-2027.webp" alt="Jahreskarten 2027 in vier Farben" loading="lazy" />
        <p style="margin-top:14px"><b>12+1 Aktion:</b> Die Jahreskarten 2027 gelten schon ab 1. Dezember 2026.</p>
        <a class="btn ink" href={contact.shop}>Jahreskarte bestellen</a>
      </div>
    </div>
  </section>
</L>
