---
import L from '../../layouts/V12.astro';
import Icon from '../../components/Icon.astro';
import Ext from '../../components/Ext.astro';
import ParkMap from '../../components/ParkMap.astro';
import '../../styles/v3.css';
import { img, highlights, prices, fmt, contact, contact as c2 } from '../../data/site';
import { slotsToday, flightSeason, upcoming, dayLabel, cleanTime, eventPhoto } from '../../data/helpers';
import zoo from '../../data/zoo.json';
const P = (f: string, w = 700) => `/img/hero/${f}-${w}.webp`;
// Hero 2: vier Foto-Wolken, die Fotos wechseln
const blobs = [['wolf-1', 'wolf-3', 'wolf-2'], ['otter-1', 'otter-2', 'otter-3'], ['katze-1', 'katze-2', 'katze-3'], ['eule-1', 'eule-2', 'eule-3'], ['fuchs-1', 'fuchs-2', 'fuchs-3'], ['adler-1', 'adler-2', 'adler-3']];
// Hero 3: ein Foto in einer Höhenlinie, die Form fließt zur nächsten Linie, wenn das Foto wechselt
const topo = [['wolf-1', 'Wolf'], ['otter-1', 'Fischotter'], ['eule-2', 'Uhu'], ['fuchs-2', 'Rotfuchs'], ['katze-2', 'Wildkatze'], ['adler-1', 'Seeadler']];
// Hero 1: Fotostreifen
const strip = [...['wolf-1', 'otter-1', 'katze-2', 'adler-1', 'eule-2', 'fuchs-1', 'wolf-2', 'otter-3', 'katze-1', 'eule-1', 'adler-2', 'fuchs-3', 'wolf-3', 'eule-3'].map((f) => P(f)), '/img/weisses-rotwild-640.webp', '/img/stoerche-640.webp', '/img/wildschwein-640.webp'];
const stats = [
  { n: '700', l: 'Tiere aus über 100 Arten', icon: 'pfote' },
  { n: '67', l: 'Hektar Wald, Wiese und Moor', icon: 'tanne' },
  { n: '2', l: 'Rundwege: 1 oder 2,5 Stunden', icon: 'karte' },
  { n: '9', l: 'Grillplätze und Grillhütten', icon: 'feuer' },
  { n: '4', l: 'Restaurant und Kioske', icon: 'besteck' },
  { n: '3', l: 'Spielplätze und Haustiere', icon: 'stern' },
];
// Heute im Park: feste Uhrzeit 11:00 (Entwurf)
const NOW = '11:00';
const slots = slotsToday();
const nextIdx = slots.findIndex((x) => x.time > NOW);
const slotPhoto: Record<string, string> = { '10:30': P('otter-2'), '11:00': '/img/tiere/baummarder.webp', '13:00': P('fuchs-2'), '14:45': img('stoerche', 640), '15:00': P('otter-3'), '15:30': P('wolf-2') };
const ev = upcoming(3);
// Tiere nach Beliebtheit, die ersten sieben mit Etikett
const popular = ['wolf', 'otter', 'wildkatze', 'seeadler', 'uhu', 'rotfuchs', 'weisses_rotwild'];
const rest = ['waschbaer', 'wildschwein', 'storch', 'schneeeule', 'dachs', 'rotwild', 'reh', 'damwild', 'hauskaninchen', 'zwergziege', 'zwergesel', 'kolkrabe', 'graukranich', 'baummarder', 'steinmarder', 'maeusebussard', 'schwarzstorch', 'loeffler', 'schwarzspecht', 'auerhuhn', 'kampflaeufer', 'heidschnucke', 'sikawild', 'blesswild', 'ringelnatter', 'honigbiene', 'schleiereule', 'waldkautz', 'steinadler', 'rotmilan', 'schwarzmilan', 'birkhuhn', 'buntspecht', 'eichhoernchen', 'jagdfasan', 'skudde', 'aspis_viper'];
const Z = zoo as any[];
const grid = [...popular, ...rest].map((s) => Z.find((a) => a.slug === s)).filter(Boolean);
const photo = (a: any) => (a.hero ? a.hero.replace('-1200.webp', '-700.webp').replace('/img/weisses-rotwild-700.webp', '/img/weisses-rotwild-640.webp').replace('/img/stoerche-700.webp', '/img/stoerche-640.webp') : a.thumb);
---
<L title="Wildpark Eekholt: 700 Tiere auf 67 Hektar" variant="v3" active="">
  <section class="r-hero2 hvr2 pt-topo" data-hero>
    <div class="r-wrap r-h2">
      <div class="r-txt">
        <p class="r-pill"><span class="dot"></span><span data-live="status">Täglich geöffnet</span></p>
        <h1>700 Tiere auf 67&nbsp;Hektar</h1>
        <p class="lede">Heimische Wildtiere in Wald, Wiese und Moor, zwischen Bad Bramstedt und Bad Segeberg. Eine knappe Stunde von Hamburg, täglich und ganzjährig geöffnet.</p>
        <div class="r-cta">
          <a class="btn ink" href="/v12/besuch/">Besuch planen</a>
          <a class="btn line" href="#karte">Lageplan ansehen</a>
        </div>
      </div>
      <div class="r-blobs" aria-hidden="true">
        {blobs.map((b, k) => (
          <div class={`blob b${k + 1}`}>
            {b.map((f, i) => <img class={i === 0 ? 'on' : ''} src={P(f, k === 0 ? 1200 : 700)} alt="" loading={i === 0 ? 'eager' : 'lazy'} />)}
          </div>
        ))}
      </div>
      <div class="r-topo" aria-hidden="true" data-topo data-names={topo.map((t) => t[1]).join('|')}>
        <svg viewBox="0 0 600 540" preserveAspectRatio="xMidYMid meet">
          <defs><clipPath id="rtopo-clip"><path data-tclip d="" /></clipPath></defs>
          <g class="rings">{[6, 5, 4, 3, 2, 1].map((i) => <path data-tring={i} d="" />)}</g>
          <path class="shade" data-tshade d="" />
          <g clip-path="url(#rtopo-clip)">
            {topo.map(([f], i) => <image href={P(f, 1200)} x="20" y="30" width="560" height="480" preserveAspectRatio="xMidYMid slice" class={i === 0 ? 'on' : ''} />)}
          </g>
          <path class="edge" data-tedge d="" />
        </svg>
        <p class="r-topo-name"><span data-tname>{topo[0][1]}</span></p>
      </div>
      <ul class="r-stats2">
        {stats.map((s, i) => <li style={`--d:${0.15 + i * 0.08}s`}><Icon name={s.icon} set="h" /><b data-count={s.n}>{s.n}</b><span>{s.l}</span></li>)}
      </ul>
    </div>
    <div class="r-strip" aria-hidden="true"><div class="track">{[...strip, ...strip].map((f) => <img src={f} alt="" loading="lazy" />)}</div></div>
  </section>

  <section class="mapsec r-map2" id="karte">
    <div class="r-wrap">
      <div class="r-head row">
        <h2>Der Park auf einen Blick</h2>
        <p>Zwei Rundwege, über 40 Gehege, Grillplätze und Spielplätze. Filtern Sie nach dem, was Sie suchen.</p>
      </div>
    </div>
    <div class="r-mapfull"><ParkMap base="/v12" pin={1.4}>
      <div class="r-mapinfo">
        <div><Icon name="navi" set="h" /><div><strong>Fürs Navi</strong>{contact.navi}</div></div>
        <div><Icon name="auto" set="h" /><div><strong>Parken</strong>Kostenlos direkt am Park, auch für Busse</div></div>
        <div><Icon name="bus" set="h" /><div><strong>Ohne Auto</strong>Bus oder Leih-Pedelec aus Bad Bramstedt: 1 € Rabatt</div></div>
        <div><Icon name="pdf" set="h" /><div><strong>Zum Ausdrucken</strong><a href="/download/Lageplan_Download.pdf" download>Lageplan als PDF</a></div></div>
      </div>
    </ParkMap></div>
  </section>

  <section class="r-sec">
    <div class="r-wrap">
      <div class="r-head">
        <h2>Heute im Park</h2>
        <p>{flightSeason() ? 'Fütterungen und Flugvorführungen' : 'Öffentliche Fütterungen. Flugvorführungen wieder ab 14. März 2027.'}</p>
      </div>
      <ol class="r-today">
        {slots.map((s, i) => (
          <li data-state={s.time === NOW ? 'now' : i === nextIdx ? 'upcoming' : ''}>
            <span class="pic"><img src={slotPhoto[s.time] || P('adler-2')} alt="" loading="lazy" /></span>
            <time>{s.time}</time>
            <span class="what">{s.what}</span>
            <span class="st" aria-hidden="true"></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="r-sec mist">
    <div class="r-wrap">
      <div class="r-head row">
        <h2>Als Nächstes im Wildpark</h2>
        <a class="more" href="/v12/veranstaltungen/">Alle 28 Termine 2026</a>
      </div>
      <div class="ev3">
        {ev.map((e) => { const d = dayLabel(e.next); return (
          <a href="/v12/veranstaltungen/">
            <figure><img src={eventPhoto[e.title] ? img(eventPhoto[e.title], 1200) : e.img} alt="" loading="lazy" /></figure>
            <div class="body">
              <span class="vdate"><i>{d.wd}</i><b>{d.day}</b><small>{d.monLong.slice(0, 3)}</small><span>{cleanTime(e.time).replace(' Uhr', '')}</span></span>
              <div><h3>{e.title}</h3>
              <p>{e.text}</p></div>
            </div>
          </a>
        ); })}
      </div>
      <p class="pnote">Alle Sonderveranstaltungen sind im Eintritt enthalten und auch mit der Jahreskarte nutzbar.</p>
    </div>
  </section>

  <section class="r-sec">
    <div class="r-wrap">
      <div class="r-head row">
        <h2>Alle Tiere, die beliebtesten zuerst</h2>
        <a class="more" href="/v12/tiere/">Steckbriefe von A bis Z</a>
      </div>
      <ul class="r-zoo2" data-zoo>
        {grid.map((a, i) => (
          <li class:list={[{ xtra: i >= 18 }]}>
            <a href={a.url} aria-label={a.name}>
              <span class="disc"><Icon name={a.icon} />{photo(a) && <img src={photo(a)} alt="" loading="lazy" />}</span>
              {i < popular.length && <em>Beliebt</em>}
              <span class="nm">{a.name}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="r-moreb"><button class="btn line" type="button" data-zoomore>Alle {grid.length} Tiere anzeigen</button></p>
    </div>
  </section>

  <section class="r-sec mist">
    <div class="r-wrap">
      <div class="r-head row">
        <h2>Eintritt</h2>
        <a class="more" href="/v12/besuch/">Alle Preise, Gruppen und Grillplätze</a>
      </div>
      <div class="r-tickets">
        <div class="tk"><span>Erwachsene</span><strong>{fmt(prices.single[0].price)}</strong></div>
        <div class="tk"><span>Kinder 4–16 Jahre</span><strong>{fmt(prices.single[2].price)}</strong></div>
        <div class="tk"><span>Familien-Tageskarte</span><strong>{fmt(prices.family.price)}</strong></div>
        <div class="tk"><span>Kinder unter 4 Jahren</span><strong>frei</strong></div>
        <div class="tk jk">
          <img src="/img/jahreskarten-2027.webp" alt="Die vier Jahreskarten 2027" loading="lazy" />
          <div><span>Jahreskarte 2027</span><strong>13 Monate zum Preis von 12</strong><a class="btn plate" href={contact.shopJk} rel="noopener" target="_blank">Im Onlineshop bestellen <Ext /></a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="r-sec r-trio2">
    <div class="r-wrap">
      <div class="r-head"><h2>Mehr als ein Ausflug</h2></div>
      <div class="r-tri">
        <article class="big">
          <img src={img('woelfe', 1200)} alt="Zwei Wölfe im Gehege" loading="lazy" />
          <div><span class="kick">Wolfsinformationszentrum</span><h3>Eekholter Wolfsmeile</h3><p>{highlights.wolfsmeile}</p><a class="btn plate" href="/v12/wolfsmeile/">Zur Wolfsmeile</a></div>
        </article>
        <article>
          <img src={img('uhu-untersuchung', 640)} alt="Ein Uhu wird in der Vogelpflegestation untersucht" loading="lazy" />
          <div><span class="kick">Seit fast 50 Jahren</span><h3>Vogelpflegestation</h3><p>{highlights.pflegeTel}</p><a class="more" href="/v12/vogelpflegestation/">Wildvogel gefunden?</a></div>
        </article>
        <article>
          <img src={img('wildkatzen', 640)} alt="Junge Wildkatzen auf einem Baumstamm" loading="lazy" />
          <div><span class="kick">Ab einem Jahr</span><h3>Tierpatenschaften</h3><p>{highlights.paten}</p><a class="more" href="/v12/unterstuetzen/tierpatenschaften/">Pate werden</a></div>
        </article>
      </div>
    </div>
  </section>

  <section class="r-sec">
    <div class="r-wrap">
      <div class="r-head"><h2>Für wen planen Sie?</h2></div>
      <div class="r-for">
        <a href="/v12/besuch/familien/"><img src={img('bachlauf-kinder', 640)} alt="" loading="lazy" /><Icon name="gruppe" set="h" /><h3>Familien</h3><p>Spielplätze, Bollerwagen, Fütterungen zum Zuschauen.</p></a>
        <a href="/v12/bildung/"><img src={img('eule-kinder', 640)} alt="" loading="lazy" /><Icon name="buch" set="h" /><h3>Schulen und Kitas</h3><p>Betreute Programme ab 3,75 € pro Kind, BNE-zertifiziert.</p></a>
        <a href="/v12/besuch/kindergeburtstag/"><img src={img('spielplatz', 640)} alt="" loading="lazy" /><Icon name="stern" set="h" /><h3>Kindergeburtstag</h3><p>1,5 Stunden mit Betreuung, 65 € zzgl. Eintritt.</p></a>
        <a href="/v12/besuch/essen-und-grillen/"><img src={img('grillkota', 640)} alt="" loading="lazy" /><Icon name="feuer" set="h" /><h3>Feiern und Grillen</h3><p>Grillplätze und Hütten ab 14 € für drei Stunden.</p></a>
      </div>
    </div>
  </section>

  <script>
    // Hero 2: Fotos in den Wolken wechseln
    const blobEls = [...document.querySelectorAll<HTMLElement>('.r-blobs .blob')];
    let step = 0;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => {
      const b = blobEls[step % blobEls.length]; step++;
      const ims = [...b.querySelectorAll('img')], i = ims.findIndex((x) => x.classList.contains('on'));
      ims[i].classList.remove('on'); ims[(i + 1) % ims.length].classList.add('on');
    }, 1800);
    // Hero 3: Höhenlinien-Maske. Die Form ist eine geschlossene Kurve r(θ) aus wenigen Wellen;
    // sie atmet langsam, beim Fotowechsel fließt sie zur nächsten Linie, und sie wölbt sich leicht zum Mauszeiger.
    {
      const box = document.querySelector<HTMLElement>('[data-topo]');
      if (box) {
        const svg = box.querySelector('svg')!;
        const clip = box.querySelector<SVGPathElement>('[data-tclip]')!, edge = box.querySelector<SVGPathElement>('[data-tedge]')!, shade = box.querySelector<SVGPathElement>('[data-tshade]')!;
        const rings = [...box.querySelectorAll<SVGPathElement>('[data-tring]')];
        const imgs = [...box.querySelectorAll<SVGImageElement>('image')];
        const nameEl = box.querySelector<HTMLElement>('[data-tname]')!;
        const names = imgs.map((_, i) => (box.dataset.names || '').split('|')[i]);
        const CX = 300, CY = 270, R = 222, N = 96;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Formen: je Wellenzahl k Amplitude und Phase. Benachbarte Formen unterscheiden sich wenig.
        const rnd = (a: number, b: number) => a + Math.random() * (b - a);
        const mkShape = () => [2, 3, 4, 5, 7].map((k) => ({ k, a: rnd(.05, .14) / (k * .42), p: rnd(0, Math.PI * 2) }));
        let from = mkShape(), to = from, mixT = 1, mix0 = 0;
        const DUR = 1600;
        let mx = 0, my = 0, pull = 0, pullT = 0;
        const shapeAt = (t: number) => {
          const e = mixT >= 1 ? 1 : mixT;
          const k = e < .5 ? 4 * e * e * e : 1 - Math.pow(-2 * e + 2, 3) / 2;
          return from.map((h, i) => ({ k: h.k, a: h.a + (to[i].a - h.a) * k, p: h.p + (to[i].p - h.p) * k + t * (.00005 * (i + 1)) }));
        };
        const radius = (sh: { k: number; a: number; p: number }[], th: number, extra: number, lvl: number) => {
          let r = 1;
          for (const h of sh) r += h.a * Math.sin(h.k * th + h.p + lvl * .35 * h.k * .2);
          // Wölbung zum Mauszeiger
          const d = Math.atan2(Math.sin(th - Math.atan2(my, mx)), Math.cos(th - Math.atan2(my, mx)));
          r += pull * .09 * Math.exp(-(d * d) / .5);
          return R * r + extra;
        };
        const pathFor = (sh: any, extra: number, lvl: number) => {
          const pts: [number, number][] = [];
          for (let i = 0; i < N; i++) { const th = (i / N) * Math.PI * 2; const r = radius(sh, th, extra, lvl); pts.push([CX + Math.cos(th) * r * 1.08, CY + Math.sin(th) * r * .86]); }
          let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
          for (let i = 0; i < N; i++) {
            const p0 = pts[(i - 1 + N) % N], p1 = pts[i], p2 = pts[(i + 1) % N], p3 = pts[(i + 2) % N];
            const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6], c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
            d += `C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
          }
          return d + 'Z';
        };
        const draw = (t: number) => {
          const sh = shapeAt(t);
          const d = pathFor(sh, 0, 0);
          clip.setAttribute('d', d); edge.setAttribute('d', d); shade.setAttribute('d', d);
          rings.forEach((r) => { const i = +r.dataset.tring!; r.setAttribute('d', pathFor(sh, i * 24 + i * i * 3, i)); });
        };
        let cur = 0;
        const next = () => {
          const t = performance.now();
          from = shapeAt(t).map((h) => ({ ...h })); from.forEach((h) => { h.p -= t * .00005 * (from.indexOf(h) + 1); });
          // nächste Linie: nahe an der jetzigen Form
          to = from.map((h) => ({ k: h.k, a: Math.min(.16 / (h.k * .42), Math.max(.01, h.a + rnd(-.06, .06) / (h.k * .42))), p: h.p + rnd(-1.2, 1.2) }));
          mix0 = t; mixT = 0;
          imgs[cur].classList.remove('on'); cur = (cur + 1) % imgs.length; imgs[cur].classList.add('on');
          nameEl.textContent = names[cur] || '';
          nameEl.parentElement!.classList.remove('flip'); void nameEl.offsetWidth; nameEl.parentElement!.classList.add('flip');
        };
        const loop = (t: number) => {
          if (mixT < 1) mixT = Math.min(1, (t - mix0) / DUR);
          pull += (pullT - pull) * .06;
          draw(t);
          if (box.offsetParent) requestAnimationFrame(loop); else setTimeout(() => requestAnimationFrame(loop), 400);
        };
        if (still) draw(0);
        else {
          requestAnimationFrame(loop);
          setInterval(() => { if (box.offsetParent && !document.hidden) next(); }, 4200);
          svg.addEventListener('pointermove', (e) => { const r = svg.getBoundingClientRect(); mx = (e.clientX - r.left) / r.width * 600 - CX; my = (e.clientY - r.top) / r.height * 540 - CY; pullT = 1; });
          svg.addEventListener('pointerleave', () => { pullT = 0; });
          svg.addEventListener('click', next);
        }
      }
    }
    // Tiere: mehr anzeigen
    const zb = document.querySelector<HTMLButtonElement>('[data-zoomore]')!;
    zb.addEventListener('click', () => { document.querySelector('[data-zoo]')!.classList.add('all'); zb.parentElement!.remove(); });
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (!e.isIntersecting) return; io.disconnect();
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((b, i) => {
          const n = +b.dataset.count!, t0 = performance.now() + i * 90, D = 1200;
          const tick = (t: number) => { const k = Math.max(0, Math.min(1, (t - t0) / D)); b.textContent = String(Math.round(n * (1 - Math.pow(1 - k, 3)))); if (k < 1) requestAnimationFrame(tick); };
          b.textContent = '0'; requestAnimationFrame(tick);
        });
      }));
      io.observe(document.querySelector('.r-stats2')!);
    }
  </script>
</L>
