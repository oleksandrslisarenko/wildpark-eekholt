---
import L from '../../../layouts/V3.astro';
import { prices, fmt, seasons, specialEntry, contact, flights, feedings } from '../../../data/site';
import { TODAY } from '../../../data/helpers';
const m = TODAY.getMonth() + 1;
const cur = m >= 3 && m <= 10 ? 'sommer' : 'winter';
const tabs = [
  { id: 'tag', label: 'Tageskarten' }, { id: 'jahr', label: 'Jahreskarten' }, { id: 'gruppe', label: 'Gruppen' },
  { id: 'schule', label: 'Schulen und Kitas' }, { id: 'extra', label: 'Grillen und Führungen' },
];
---
<L title="Preise und Öffnungszeiten – Wildpark Eekholt" description="Eintrittspreise, Jahreskarten, Gruppenpreise und Einlasszeiten des Wildpark Eekholt. Täglich und ganzjährig geöffnet." active="besuch">
  <section class="visit-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/v3/">Start</a><span>Besuch planen</span></p>
      <h1>Preise und Öffnungszeiten</h1>
      <p>Täglich und ganzjährig geöffnet, auch an Feiertagen. Nach dem letzten Einlass können Sie bis zur Dunkelheit bleiben.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="oh">{seasons.map((s) => <article class={s.id === cur ? 'cur' : ''}><p>{s.label}</p><div class="t">{s.open}–{s.lastEntry}</div><p style="margin:0">Einlass täglich</p></article>)}</div>
      <p class="pnote">{specialEntry} Verlassen können Sie den Park jederzeit durch das Drehtor.</p>
    </div>
  </section>

  <section class="sec warm">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:22px"><span class="it">Eintritt</span>Preise 2026/27</h2>
      <div class="tabs" role="tablist">{tabs.map((t, i) => <button type="button" role="tab" id={`t-${t.id}`} aria-controls={`p-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.label}</button>)}</div>

      <div class="panel" role="tabpanel" id="p-tag" aria-labelledby="t-tag">
        <ul class="plist">
          {prices.single.map((p) => <li><small>{p.label}</small><b>{fmt(p.price)}</b></li>)}
          <li class="fam"><small>{prices.family.label}: {prices.family.note}</small><b>{fmt(prices.family.price)}</b></li>
        </ul>
      </div>
      <div class="panel" role="tabpanel" id="p-jahr" aria-labelledby="t-jahr" hidden>
        <div class="jkrow">{prices.annual.map((a) => <div class={`jk ${a.color}`}><div class="band"><small>Jahreskarte</small><span style="font-size:24px;font-weight:800">{a.label}</span><span>{a.note || 'ab 16 Jahren'}</span><b>{fmt(a.price)}</b></div></div>)}</div>
        <p class="pnote">{prices.annualNote}</p>
        <a class="btn ink" href={contact.shop}>Im Onlineshop bestellen</a>
      </div>
      <div class="panel" role="tabpanel" id="p-gruppe" aria-labelledby="t-gruppe" hidden>
        <ul class="plist">{prices.groups.map((p) => <li><small>{p.label}</small><b>{fmt(p.price)}</b></li>)}</ul>
        <p class="pnote">{prices.groupsNote}</p>
      </div>
      <div class="panel" role="tabpanel" id="p-schule" aria-labelledby="t-schule" hidden>
        <ul class="plist">{prices.schools.map((p) => <li><small>{p.label}</small><b>{fmt(p.price)}</b></li>)}</ul>
        <p class="pnote">{prices.schoolsNote}</p>
      </div>
      <div class="panel" role="tabpanel" id="p-extra" aria-labelledby="t-extra" hidden>
        <ul class="plist">{prices.extras.map((p) => <li><small>{p.label}</small><b>{fmt(p.price)}</b>{p.extra && <small>{p.extra}</small>}</li>)}</ul>
        <p class="pnote">Bitte vorher anmelden: <a href={contact.phoneHref}>{contact.phone}</a>, {contact.office}.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:22px"><span class="it">Jeden Tag</span>Fütterungen</h2>
      <ul class="feedtab">{feedings.map((f) => <li data-slot={f.time} data-kind="feed"><b>{f.time}</b>{f.what}</li>)}</ul>
      <p class="pnote">Flugvorführungen {flights.season}, täglich {flights.times.join(', ')} Uhr. {flights.note}</p>
    </div>
  </section>

  <section class="sec warm">
    <div class="wrap">
      <h2 class="h2" style="margin-bottom:22px"><span class="it">Gut zu wissen</span>Hunde, Räder, Bollerwagen</h2>
      <ul class="plist">{prices.rules.map((r) => <li style="min-height:0">{r}</li>)}</ul>
    </div>
  </section>
  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    tabs.forEach((t) => t.addEventListener('click', () => {
      tabs.forEach((x) => { x.setAttribute('aria-selected', String(x === t)); document.getElementById(x.getAttribute('aria-controls')!)!.hidden = x !== t; });
    }));
  </script>
</L>
