---
// Vorschau der mobilen Version im Telefonrahmen
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Mobile Vorschau – Wildpark Eekholt</title><meta name="robots" content="noindex" />
  <link rel="icon" href="/img/eagle.svg" />
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #F3F3EE; font: 15px/1.4 system-ui, sans-serif; }
    .phone { width: 390px; height: min(844px, calc(100vh - 80px)); border: 12px solid #111; border-radius: 48px; overflow: hidden; box-shadow: 0 30px 60px rgba(0,0,0,.25); background: #fff; }
    iframe { width: 100%; height: 100%; border: 0; display: block; }
    p { margin: 14px 0 0; text-align: center; color: #55574E; }
    a { color: #000; }
    @media (max-width: 500px) { body { display: block; } .phone { width: 100%; height: 100vh; border: 0; border-radius: 0; } p { display: none; } }
  </style>
</head>
<body>
  <div>
    <div class="phone"><iframe id="f" title="Mobile Vorschau"></iframe></div>
    <p><a id="d" href="/" target="_blank" rel="noopener">Als Desktop-Version öffnen</a> · <a href="/">Alle Entwürfe</a></p>
  </div>
  <script is:inline>
    var u = new URLSearchParams(location.search).get('u') || '/v12/';
    if (!/^\/[\w\-\/]*$/.test(u)) u = '/v12/';
    document.getElementById('f').src = u;
    document.getElementById('d').href = u;
  </script>
</body>
</html>
